# FUNKTIONEN
# (auch wenn's keine Aliase sind: hier statt in der .bashrc, da diese
#  Datei ohnehin früh beim Start geladen wird)
# ══════════════════════════════════════════════════════════════════

# findgrep [grep-Optionen] <suchbegriff>: durchsucht rekursiv alle Dateien im
# aktuellen Verzeichnis (außer .git) nach <suchbegriff> (case-insensitive),
# überspringt Binärdateien, zeigt Dateiname:Zeilennummer:Zeileninhalt und hebt
# den Treffer im Text farbig hervor. Weitere grep-Optionen (z.B. -w, -v) können
# vor dem Suchbegriff übergeben werden, das jeweils letzte Argument gilt immer
# als Suchmuster.
# Als Funktion statt Alias, weil $1 mitten im Kommando (vor "{} +") gebraucht wird.
findgrep() {
    if [ "$#" -eq 0 ]; then
        echo "Verwendung: findgrep [grep-Optionen] <Suchbegriff>" >&2
        return 1
    fi
    # "${@: -1}" (Leerzeichen vor -1 Pflicht, sonst Verwechslung mit der
    # ${@:-1}-Default-Wert-Syntax) = letztes Argument = Suchmuster.
    # "${@:1:$#-1}" = alle Argumente davor (Index 1 bis $#-1) = zusätzliche
    # grep-Optionen; als Array, damit jede Option beim Aufruf unten ein
    # eigenes Wort bleibt statt als ein zusammenhängender String durchzugehen.
    local pattern="${@: -1}"
    local opts=("${@:1:$#-1}")
    # find: -type f = nur reguläre Dateien; -not -path '*/.git/*' schließt
    # Git-internes aus. -exec ... {} + (statt \;) sammelt möglichst viele
    # Treffer in einem einzigen grep-Aufruf statt pro Datei neu zu starten.
    # grep: -i case-insensitive, -n Zeilennummer, --color=auto nur bei
    # Terminal-Ausgabe färben (nicht bei Pipe/Umleitung), -I (groß)
    # Binärdateien komplett überspringen statt "Binary file X matches".
    # -- markiert das Ende der Optionen, damit ein Suchmuster, das zufällig
    # mit "-" beginnt, nicht als (unbekannte) grep-Option missverstanden wird.
    find . -type f -not -path '*/.git/*' -exec grep -in --color=auto -I "${opts[@]}" -- "$pattern" {} +
    _hinweis "Es gibt auch das schnellere 'findrg'"
}

# findrg [rg-Optionen] <suchbegriff>: wie findgrep, aber mit ripgrep (rg) statt
# find+grep. Respektiert .gitignore automatisch, überspringt .git und
# Binärdateien von selbst und ist deutlich schneller. rg parst Optionen und
# Suchmuster selbst, daher kein manuelles Aufteilen der Argumente nötig wie
# bei findgrep.
findrg() {
    if [ "$#" -eq 0 ]; then
        echo "Verwendung: findrg [rg-Optionen] <Suchbegriff>" >&2
        return 1
    fi
    # -i case-insensitive wie bei grep. "$@" statt einzelnem $1, weil rg
    # (anders als findgrep oben) selbst erkennt, was Option, Pfad oder
    # Suchmuster ist -- kein manuelles Aufteilen der Argumente nötig.
    rg -i "$@"
}

# fd-Wrapper: fd (im Gegensatz zu z.B. rg) zeigt versteckte Dateien/Ordner nur
# mit -H/--hidden, was leicht übersehen wird. Statt fd standardmäßig auf -H
# umzustellen (würde .git & Co. mit reinziehen, da fd .git nur über
# .gitignore-artige Ignore-Regeln kennt, nicht als Sonderfall) gibt es bei
# wenigen Treffern einen Hinweis auf -H/-u. -H/-u im Aufruf bereits gesetzt ->
# reiner Passthrough ohne Hinweis, ohne Zwischenpuffern (Live-Streaming/Farbe
# von fd bleiben unangetastet).
fd() {
    local a
    for a in "$@"; do
        case "$a" in
            -H|--hidden|-u|--unrestricted*)
                command fd "$@"
                return
                ;;
        esac
    done

    # --color=$color statt fd selbst über die eigene TTY-Erkennung
    # entscheiden zu lassen: die Ausgabe wird unten in $out abgefangen (um
    # die Trefferzahl zu zählen), dabei sieht fd stdout nicht mehr als
    # Terminal und würde Farben sonst von sich aus abschalten.
    local color=auto
    [[ -t 1 ]] && color=always

    local out
    out=$(command fd --color="$color" "$@")
    local status=$?

    [[ -n "$out" ]] && printf '%s\n' "$out"

    if (( status == 0 )); then
        local count=0
        [[ -n "$out" ]] && count=$(grep -c '' <<<"$out")
        if (( count <= 5 )); then
            _hinweis "versteckte Dateien: -H, alles inkl. .git: -u"
        fi
    fi

    return "$status"
}

# claudegrep [--all] [--lines N] <suchbegriff> [Verzeichnis]: durchsucht
# Claude-Code-Session-Logs (Standard: ~/.claude/projects/**/*.jsonl) nach
# <suchbegriff> im Text von User-/Assistant-Nachrichten (case-insensitive).
# Ignoriert thinking-/tool_use-/tool_result-Blöcke, da dort nur Rauschen
# (Tool-Output, Denkprotokolle) statt lesbarem Text steht -- genau das, was
# findgrep/findrg auf den rohen JSONL-Dateien mitausgeben würden. Zeigt statt
# der JSON-Rohzeile pro Treffer Zeitstempel, Rolle sowie den (von Claude Code
# automatisch generierten oder manuell gesetzten) Session-Titel -- deutlich
# aussagekräftiger als der reine Projektpfad, der bei Sessions direkt in
# TMP/ oder SECOND_BRAIN/ oft nur den generischen Oberordner zeigt; der Pfad
# steht trotzdem gedimmt in Klammern dahinter. Treffer farbig hervorgehoben.
# Nach Session gruppiert: der (fett hervorgehobene) Titel/Pfad-Header inkl.
# "="-Trennlinie wird nur einmal pro Session gezeigt, weitere Treffer
# derselben Session folgen eingerückt direkt darunter (siehe Kommentar bei
# "foreach" unten). Zeitstempel werden von UTC (so speichert Claude Code sie)
# in Lokalzeit umgerechnet; das Datum steht als eigene "── TT.MM.JJ ──"-
# Zwischenzeile nur bei Wechsel (Sessionwechsel oder Tageswechsel innerhalb
# einer Session), pro Treffer-Zeile nur noch "HH:MM". Rolle einbuchstabig als
# "h" (harry, User-Nachricht) / "c" (claude, Assistant-Nachricht).
# Standardmäßig wird jeder Treffer auf eine einzige Zeile begrenzt: die
# Breite des Ausschnitts um den ersten Treffer richtet sich nach der
# tatsächlichen Terminalbreite (abzüglich des Zeitstempel/Rolle-Präfixes),
# nicht nach einer festen Zeichenzahl -- lange Nachrichten (z.B.
# Context-Compaction-Zusammenfassungen) würden sonst seitenweise Kontext
# ausgeben, in dem der Treffer selbst kaum auffindbar ist, und ein zu breiter
# fester Ausschnitt würde auf schmalen Terminals umbrechen statt eine Zeile
# zu bleiben. --lines N zeigt stattdessen bis zu N Zeilen um den Treffer
# (an Wortgrenzen umgebrochen, Folgezeilen unter dem Ausschnitt eingerückt)
# -- praktisch auf schmalen Terminals (z.B. iPhone-SSH-Client), wo eine
# einzige Zeile kaum Kontext zeigt. Mit --all wird die komplette Nachricht
# gezeigt (kann mehrere Zeilen/den Bildschirm füllen).
claudegrep() {
    # --all und --lines können an beliebiger Position stehen -- while+case
    # statt der alten for-Schleife, weil --lines seinen Wert aus dem
    # NÄCHSTEN Argument liest (shift 2) und eine einfache for-a-in-Schleife
    # dafür keinen Zugriff auf "das nächste Element" bietet.
    local all=0
    local lines_opt=1
    local args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --all)
                all=1
                shift
                ;;
            --lines)
                lines_opt="$2"
                shift 2
                ;;
            *)
                args+=("$1")
                shift
                ;;
        esac
    done
    if [ "${#args[@]}" -eq 0 ]; then
        echo "Verwendung: claudegrep [--all] [--lines N] <Suchbegriff> [Verzeichnis]" >&2
        return 1
    fi
    # Nur echte positive Ganzzahlen zulassen -- eine leere/falsche Eingabe
    # (z.B. "--lines" ohne Wert am Ende der Argumentliste, oder Buchstaben)
    # würde sonst als Textbaustein in $lines_opt landen und erst in jq mit
    # einer kryptischen Fehlermeldung auffallen.
    case "$lines_opt" in
        ''|*[!0-9]*|0)
            echo "Verwendung: claudegrep [--all] [--lines N] <Suchbegriff> [Verzeichnis]  (N muss eine positive Zahl sein)" >&2
            return 1
            ;;
    esac
    local pattern="${args[0]}"
    # "${args[1]:-...}" = zweites Argument, oder Default falls nicht gesetzt.
    local dir="${args[1]:-$HOME/.claude/projects}"
    # $'\033[...' = Bash-ANSI-C-Quoting; \033 ist das ESC-Byte (oktal 33 =
    # dezimal 27), gefolgt vom SGR-Farbcode: 36 cyan, 33 gelb, 1;35 fett+
    # magenta, 2 gedimmt, 1;31 fett+rot, 0 = zurücksetzen.
    local c_ts=$'\033[36m' c_role=$'\033[33m' c_loc=$'\033[1;35m' c_dim=$'\033[2m' c_hit=$'\033[1;31m' c_off=$'\033[0m'

    # Terminalbreite ermitteln (für Ausschnittsbreite und Trennlinie unten).
    # </dev/tty statt Default-stdin: claudegrep wird oft in eine Pipe (z.B.
    # "| less") gehängt, dann zeigt stdout selbst keine Terminalbreite mehr,
    # das echte Terminal bleibt aber über /dev/tty erreichbar. 2>/dev/null
    # VOR </dev/tty (Reihenfolge zählt!): schlägt das Öffnen von /dev/tty
    # fehl (z.B. in einem Cronjob ganz ohne Terminal), soll die Fehlermeldung
    # unterdrückt werden -- das geht nur, wenn stderr schon umgeleitet ist,
    # BEVOR die fehlschlagende Umleitung an die Reihe kommt.
    local cols
    cols=$(tput cols 2>/dev/null </dev/tty)
    [ -n "$cols" ] || cols=80

    # Vorfilter mit grep -P statt sofort auf alle Dateien mit jq loszugehen:
    # jq muss pro Zeile erst das komplette JSON parsen, bevor $pattern
    # getestet werden kann -- das dominiert die Laufzeit fast vollständig
    # (Messung: 4s für ~217MB bei einem häufigen Suchwort, obwohl derselbe
    # Bestand mit rohem grep in 17ms durchsucht ist -- Faktor ~240). Mit
    # cleanupPeriodDays jetzt auf 10 Jahre (statt 30 Tage) gesetzt gibt es
    # kein automatisches Volumenlimit mehr, das jq-only-Laufzeiten klein
    # hält; bei linearer Skalierung wären das bei den in 2 Jahren erwarteten
    # ~5GB rund 90s pro Suche. -P (PCRE) statt -E (POSIX ERE), weil jqs
    # Regex-Dialekt (Oniguruma) PCRE-nahe Konstrukte wie \d, \s, (?:...)
    # kennt, die POSIX ERE nicht versteht -- -P kommt dem, was $pattern in
    # jq bewirkt, näher als -E. -Z (NUL-getrennte Ausgabe) + Ablage in einer
    # Datei statt eines Bash-Arrays, damit die Liste unten per `xargs -0`
    # ohne eigenes Chunking (bei sehr vielen Dateien sonst Gefahr von
    # "Argument list too long") an grep/jq weitergereicht werden kann --
    # dieselbe automatische Aufteilung, die vorher `find -exec {} +` schon
    # geleistet hat.
    local filelist
    filelist=$(mktemp)
    grep -rlZiP --include='*.jsonl' -- "$pattern" "$dir" > "$filelist" 2>/dev/null
    local grep_rc=$?
    if [ "$grep_rc" -eq 1 ]; then
        # Exit 1 = Muster syntaktisch gültig, aber in keiner Datei
        # enthalten -- jq würde ebenfalls nichts finden, kann also
        # komplett übersprungen werden.
        rm -f "$filelist"
        return 0
    elif [ "$grep_rc" -gt 1 ]; then
        # Exit >1 = echter Fehler (z.B. $pattern ist gültiges
        # jq/Oniguruma-Regex, aber kein gültiges PCRE) -- Vorfilter
        # unzuverlässig, also NICHT stillschweigend Treffer verschlucken,
        # sondern zurückfallen auf die ungefilterte Originalvariante (alle
        # Dateien, kein Vorfilter -- dann wieder mit der alten Laufzeit,
        # aber korrekt).
        find "$dir" -name '*.jsonl' -type f -print0 > "$filelist"
    fi
    if [ ! -s "$filelist" ]; then
        rm -f "$filelist"
        return 0
    fi

    # Session-Titel vorab einsammeln (sessionId -> Titel): Claude Code
    # schreibt pro Session ai-title (automatisch generiert) und optional
    # custom-title (manuell überschrieben) als eigene JSONL-Zeilen. Nur noch
    # über $filelist (die vorgefilterten Kandidaten) statt über das
    # komplette Archiv -- Titel für Sessions ohne Treffer werden unten
    # ohnehin nie nachgeschlagen. grep filtert diese wenigen Zeilen vor (die
    # Objekte selbst reichen als reiner Text zum Erkennen, ohne dass grep
    # sie parsen müsste) -- ohne diesen Vorfilter müsste jq jede Datei
    # komplett durchparsen nur um die paar Titel-Zeilen zu finden.
    # `{(.sessionId): (.customTitle // .aiTitle)}` baut pro Zeile ein
    # Ein-Schlüssel-Objekt; `jq -s 'add'` merged alle zu einem Objekt, wobei
    # bei doppeltem sessionId (ai-title zuerst, später manuell umbenannt zu
    # custom-title) der chronologisch letzte Eintrag gewinnt.
    local titlemap
    titlemap=$(mktemp)
    xargs -0 grep -hE '"type": ?"(ai-title|custom-title)"' < "$filelist" 2>/dev/null \
        | jq -c '{(.sessionId): (.customTitle // .aiTitle)}' \
        | jq -s 'add // {}' > "$titlemap"

    # xargs -0 statt find -exec: die Dateiliste steht schon in $filelist
    # (vorgefiltert oder im Fallback alle *.jsonl), xargs übernimmt nur noch
    # das automatische Aufteilen in mehrere jq-Aufrufe, falls die Liste zu
    # lang für eine einzelne Kommandozeile wird (dieselbe Rolle wie vorher
    # `find -exec ... {} +`).
    # jq: -r ("raw output") gibt Strings ohne umschließende "..." aus, sonst
    # würde jq jeden String als JSON-Literal mit Anführungszeichen liefern.
    # --arg name wert übergibt eine Bash-Variable als jq-Variable $name (als
    # String) -- nötig, weil das jq-Programm in '...' steht und daher keine
    # Bash-Variablen-Expansion darin stattfindet. --slurpfile lädt die oben
    # gebaute Titel-Map als jq-Variable $tmap (Array mit einem Element, dem
    # geparsten JSON-Objekt aus der Datei).
    #
    # -n (null input) + "foreach inputs as $r": normalerweise verarbeitet jq
    # automatisch jede JSON-Zeile als eigenen "Durchlauf" durch die ganze
    # Pipeline (das war die Basis der vorherigen, ungruppierten Version).
    # Für die Gruppierung wird aber Zustand über mehrere Zeilen hinweg
    # gebraucht ("welche sessionId hatte der letzte ausgegebene Treffer?"),
    # und das geht nur mit manueller Iteration über "inputs" statt der
    # impliziten Pro-Zeile-Verarbeitung. Das Filtern (welche Zeilen zählen
    # überhaupt als Treffer) läuft dafür vorab in der def "hit" -- so sieht
    # "foreach" nur noch echte Treffer und muss selbst keine "kein Treffer"-
    # Fälle mehr unterscheiden. "foreach EXPR as $var (INIT; UPDATE;
    # EXTRACT)" hält einen Zustand über die gesamte Eingabe hinweg: UPDATE
    # berechnet pro Treffer den neuen Zustand, EXTRACT liefert daraus die
    # Ausgabe -- $var bleibt dabei auch in EXTRACT gültig, UPDATE muss also
    # nur vermerken OB sich die Session geändert hat, nicht das fertige
    # Ausgabe-Format mitschleppen. Wichtig für die Gruppierung: jq liest bei
    # mehreren Dateiargumenten (wie hier durch das gebündelte find-exec
    # oben) jede Datei komplett hintereinander aus, bevor die nächste
    # beginnt -- Treffer derselben Session (= eine JSONL-Datei) liegen
    # dadurch im Eingabestrom immer schon zusammen, ohne dass vorher
    # sortiert werden müsste.
    xargs -0 jq -n -r \
        --arg p "$pattern" \
        --arg all "$all" \
        --argjson cols "$cols" \
        --argjson lines "$lines_opt" \
        --slurpfile tmap "$titlemap" \
        --arg c_ts "$c_ts" --arg c_role "$c_role" --arg c_loc "$c_loc" --arg c_dim "$c_dim" \
        --arg c_hit "$c_hit" --arg c_off "$c_off" '
        # highlight($s): umschließt jeden Treffer von $p in $s mit Farbcode
        # (case-insensitive). gsub("(?<m>"+$p+")"; ...; "i"): globales
        # Suchen&Ersetzen mit benannter Capture-Gruppe "m"; im Replacement
        # über \(.m) wieder eingesetzt. Eigene def, weil dieselbe Ersetzung
        # unten an zwei Stellen auf unterschiedlichem Text läuft (kompletter
        # Text bei --all, nur der Fenster-Ausschnitt sonst) -- so bleibt der
        # Suchen&Ersetzen-Ausdruck nur einmal geschrieben.
        def highlight($s): $s | gsub("(?<m>" + $p + ")"; $c_hit + "\(.m)" + $c_off; "i");

        # wrap($width): zerlegt einen String in ein Array von Zeilen, die
        # (an Leerzeichen entlang, klassischer "greedy" Umbruch) jeweils
        # höchstens $width Zeichen breit sind. split(" ") + map(select(...))
        # filtert doppelte Leerzeichen raus (sonst leere "Wörter" im Array,
        # die als führendes Leerzeichen in der nächsten Zeile aufgetaucht
        # wären). reduce baut das Zeilen-Array Wort für Wort auf: passt das
        # nächste Wort noch in die letzte Zeile (inkl. einem Trenn-Leerzeichen),
        # wird es angehängt, sonst beginnt eine neue Zeile. Kein Silbentrennen
        # -- ein einzelnes Wort, das breiter als $width ist, bleibt als eigene
        # (dann zu lange) Zeile stehen, statt mitten im Wort zu brechen.
        def wrap($width):
          (. | split(" ") | map(select(. != ""))) as $words
          | reduce $words[] as $w
              ([""];
                (if .[-1] == "" then $w else .[-1] + " " + $w end) as $cand
                | if (.[-1] == "" or ($cand | length) <= $width)
                  then .[:-1] + [$cand]
                  else . + [$w]
                  end);

        def hit:
          select(.type == "user" or .type == "assistant")
          # .content ist je nach Nachricht ein String oder ein Array von
          # Blöcken (Text/Denken/Tool-Aufruf/Tool-Ergebnis) -- hier werden
          # nur die "text"-Blöcke rausgezogen und zusammengefügt, der Rest
          # (reines Rauschen für die Suche) bleibt außen vor.
          | (.message.content
             | if type == "string" then .
               else ([.[] | select(.type == "text") | .text] | join(" "))
               end) as $text
          # test($p; "i"): Regex-Test (nur ja/nein), "i" = case-insensitive.
          | select($text != "" and ($text | test($p; "i")))
          | {sid: .sessionId, ts: .timestamp, role: .message.role, cwd: (.cwd // "?"), text: $text};

        foreach (inputs | hit) as $r
          ( {prev: null, prevdate: null};
            # "first" merkt sich (aus dem ALTEN .prev, vor dem Überschreiben
            # in dieser Zeile), ob dies der allererste Treffer überhaupt ist
            # -- nur dann ist .prev noch null. So lässt sich unten "neue
            # Gruppe, aber nicht die allererste" erkennen, um dort (und nur
            # dort) eine Leerzeile einzufügen, ohne dass ganz oben in der
            # Ausgabe eine überflüssige führende Leerzeile entsteht.
            #
            # $curdate: lokales Datum dieses Treffers, hier (statt erst in
            # EXTRACT) berechnet, weil es sowohl zum Vergleich mit .prevdate
            # als auch als neuer Zustand gebraucht wird -- EXTRACT liest es
            # unten einfach aus .prevdate zurück, keine doppelte Berechnung.
            # $sidchanged trägt zu $datechanged bei: bei jedem Sessionwechsel
            # soll das Datum immer neu angezeigt werden (auch wenn es
            # zufällig mit dem Datum der letzten Zeile der vorigen Session
            # übereinstimmt) -- sonst müsste man beim Lesen nach oben scrollen,
            # um das Datum der neuen Gruppe zu erfahren.
            ($r.ts | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601 | localtime
             | strftime("%d.%m.%y")) as $curdate
            | ($r.sid != .prev) as $sidchanged
            | {prev: $r.sid, prevdate: $curdate, changed: $sidchanged,
               datechanged: ($sidchanged or ($curdate != .prevdate)),
               first: (.prev == null)};
            # Titel-/Pfad-Header nur berechnen und ausgeben, wenn die Session
            # gegenüber dem letzten Treffer gewechselt hat -- sonst reine
            # Verschwendung, da er sofort verworfen würde. // ist der
            # "Alternative"-Operator: rechter Wert, falls .cwd fehlt/null ist
            # (Fallback). $tmap[0][$r.sid] schlägt die aktuelle Session im
            # Titel-Objekt nach; ohne Treffer (z.B. noch laufende Session
            # ohne Titel-Zeile) bleibt $title null und der Pfad allein wird
            # angezeigt.
            # Trennlinie ("═" * Breite): jq wiederholt einen String bei
            # Multiplikation mit einer Zahl n-mal. "═" (U+2550, fette
            # Box-Zeichnung) statt schlichtem "=", passend zum ═-Boxenstil
            # der restlichen Datei (siehe Abschnitts-Header oben). Fix 60
            # Zeichen breit statt Terminalbreite -- eine volle Bildschirm-
            # breite wirkte auf breiten Terminals zu dominant; [$cols, 60]|min
            # verhindert trotzdem ein Überlaufen auf schmalen Terminals.
            (if .changed then
               (if .first then "" else "\n" end) as $lead
               | ($tmap[0][$r.sid] // null) as $title
               | $lead + (if $title then "\($c_loc)\($title)\($c_off) \($c_dim)(\($r.cwd))\($c_off)"
                          else "\($c_loc)\($r.cwd)\($c_off)" end)
               + "\n" + $c_dim + ("═" * ([$cols, 60] | min)) + $c_off + "\n"
             else "" end) as $header
            # Datums-Zwischenzeile: nur ausgeben, wenn sich das Datum
            # gegenüber dem letzten Treffer geändert hat (.datechanged kommt
            # oben aus UPDATE, inkl. Sessionwechsel-Fall). .prevdate enthält
            # in EXTRACT bereits das Datum DIESES Treffers (UPDATE hat es
            # gerade dort abgelegt) -- keine erneute Berechnung nötig. Eigene,
            # dünnere "─"-Linie (U+2500) statt der dicken "═"-Trennlinie oben,
            # damit die Datumszeile optisch klar unter dem Session-Header
            # steht und nicht mit ihm verwechselt wird.
            | (if .datechanged then "  \($c_dim)── \(.prevdate) ──\($c_off)\n" else "" end) as $datehdr
            # $r.ts kommt als ISO8601-UTC ("...T...Z", mit Millisekunden) --
            # sub(...) entfernt die Millisekunden (fromdateiso8601 erwartet
            # exakt "%Y-%m-%dT%H:%M:%SZ", an Nachkommastellen scheitert es
            # sonst), fromdateiso8601 wandelt in Unix-Timestamp (UTC),
            # localtime wandelt (systemabhängig über die TZ-Umgebung) in
            # lokale Zeit um -- ohne diesen Schritt stünde UTC-Zeit da, in
            # meiner Zeitzone (Sommerzeit) zwei Stunden hinter der Wanduhr.
            # Nur noch die Uhrzeit (das Datum steht jetzt in $datehdr) --
            # macht das Präfix jeder Treffer-Zeile deutlich kürzer, wichtig
            # auf schmalen Terminals (z.B. iPhone-SSH-Client).
            | ($r.ts | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601 | localtime
               | strftime("%H:%M")) as $tsplain
            # "h"/"c" statt "user"/"assistant": h wie harry (Userrolle), c wie
            # claude (Assistant-Rolle).
            | (if $r.role == "assistant" then "c" else "h" end) as $roleabbr
            # $prefixlen = sichtbare Breite von Zeitstempel+Rolle-Präfix
            # (ohne Farbcodes, die zählen für die Terminal-Spaltenbreite
            # nicht mit) -- aus dem tatsächlichen Text berechnet statt als
            # Zahl fest hinzuschreiben, damit sie bei einer künftigen
            # Formatänderung automatisch stimmt. $avail = Rest der
            # Terminalbreite, die für den Treffer-Ausschnitt bleibt; min. 10,
            # damit auf sehr schmalen Terminals nichts Negatives/Winziges
            # herauskommt.
            | ("  \($tsplain) \($roleabbr): " | length) as $prefixlen
            | (if ($cols - $prefixlen) > 10 then ($cols - $prefixlen) else 10 end) as $avail
            | (if $all == "1" then
                 highlight($r.text)
               else
                 # match($p; "i"): wie test, liefert zusätzlich die
                 # Fundstelle (.offset/.length) des ersten Treffers -- daraus
                 # wird unten das Fenster drumrum berechnet (mit
                 # Rand-Clamping auf 0 bzw. Textende) und per Slicing
                 # ($r.text[$start:$end]) rausgeschnitten. $half = Platz je
                 # Seite des Treffers: von $budget (= $avail, mit --lines
                 # N vervielfacht) zieht -2 Reserve für die beiden möglichen
                 # "…"-Ellipsen ab, und -$mt.length, weil der Treffer selbst
                 # auch im Fenster steht und daher zum Budget zählt
                 # (Fenstergröße gesamt = $half + Treffer + $half); ohne
                 # diesen letzten Abzug wäre das Fenster immer um die
                 # Trefferlänge zu breit.
                 ($avail * $lines) as $budget
                 | ($r.text | match($p; "i")) as $mt
                 | ($r.text | length) as $tlen
                 | ((($budget - 2 - $mt.length) / 2 | floor) as $h
                    | if $h > 0 then $h else 0 end) as $half
                 | (if ($mt.offset - $half) > 0 then ($mt.offset - $half) else 0 end) as $start
                 | (if ($mt.offset + $mt.length + $half) < $tlen then ($mt.offset + $mt.length + $half) else $tlen end) as $end
                 | ($r.text[$start:$end] | gsub("\n"; " ")) as $window
                 # $window ist char-genau auf $budget zugeschnitten, aber
                 # noch eine einzige lange Zeile -- wrap(...) bricht sie an
                 # Wortgrenzen auf gleich breite Zeilen um. Breite $avail - 1
                 # statt $avail: pro Zeile ist maximal EIN Zeichen Puffer für
                 # eine später angehängte "…"-Ellipse nötig (vorne bei $pre,
                 # hinten bei $post) -- wrap selbst weiß beim Umbrechen noch
                 # nicht, welche Zeile das treffen wird, daher pauschal 1
                 # Zeichen auf allen Zeilen reserviert statt nachträglich neu
                 # zu umbrechen. Bei --lines 1 (Default) ist $budget == $avail,
                 # wrap liefert dann so gut wie immer genau eine Zeile zurück
                 # -- Verhalten bleibt damit für den Default-Fall praktisch
                 # unverändert (nur 1 Zeichen schmaler als vorher).
                 | ($window | wrap($avail - 1)) as $wraplines
                 | ($wraplines | length) as $wc
                 # Mehr umgebrochene Zeilen vorhanden als $lines erlaubt?
                 # Dann werden die überzähligen abgeschnitten und $post
                 # (Ellipse am Ende) erzwungen -- unabhängig davon, ob der
                 # ORIGINALTEXT an der Stelle schon zu Ende war.
                 | ($wraplines[0:$lines]) as $kept
                 | ($wc > $lines) as $wraptruncated
                 # Jede behaltene Zeile einzeln highlighten (nicht erst
                 # zusammenfügen und dann highlighten) -- gsub würde sonst
                 # theoretisch über eine Zeilengrenze hinweg matchen und die
                 # Färbung so verschieben, dass sie nicht mehr zur later
                 # eingefügten Einrückung passt. Ab Zeile 2 wird mit
                 # $prefixlen Leerzeichen eingerückt, damit der Text unter
                 # dem eigentlichen Ausschnitt (nach "HH:MM h: ") weiterläuft
                 # statt am linken Rand.
                 | ($kept | to_entries | map(
                     (if .key == 0 then "" else "\n" + (" " * $prefixlen) end)
                     + highlight(.value)
                   ) | join("")) as $hwindow
                 | (if $start > 0 then "…" else "" end) as $pre
                 | (if ($end < $tlen) or $wraptruncated then "…" else "" end) as $post
                 | "\($pre)\($hwindow)\($post)"
               end) as $bodytext
            # Kein abschließendes "\n" hier: jq -r hängt nach jedem Wert, den
            # foreach/EXTRACT ausgibt, ohnehin automatisch einen Zeilenumbruch
            # an -- ein zusätzliches "\n" in diesem String hätte pro Treffer
            # eine Leerzeile erzeugt.
            | "\($header)\($datehdr)  \($c_ts)\($tsplain)\($c_off) \($c_role)\($roleabbr)\($c_off): \($bodytext)"
          )
    ' < "$filelist"
    rm -f "$titlemap" "$filelist"
}

# `chezmoi cd` überschreiben: statt einer echten Subshell nur ein
# `cd` in der aktuellen Shell, damit sich das nicht mehr verschachteln
# kann (siehe pstree-Vorfall vom 2026-08-08 mit 7 verschachtelten
# `chezmoi cd`-Subshells). Alle anderen Subcommands gehen unverändert
# ans echte Binary durch.
chezmoi() {
  if [ "$1" = cd ] && [ "$2" != -h ] && [ "$2" != --help ]; then
    shift
    local dir
    dir=$(command chezmoi source-path "$@") || return
    builtin cd "$dir"
  else
    command chezmoi "$@"
  fi
}

# `tealdeer cd`: springt in Analogie zu `chezmoi cd` direkt (kein
# Subshell) ins Custom-Pages-Verzeichnis von tealdeer, in dem eigene/
# gepatchte tldr-Seiten liegen. Eigener Funktionsname `tealdeer` statt
# `tldr`, damit die normale tldr-Seite "cd" (Anzeige der cd-Hilfe)
# nicht überschrieben wird. tealdeer kennt kein natives `cd`-
# Subcommand, der Pfad wird daher aus `tldr --show-paths` geparst statt
# hartkodiert.
tealdeer() {
  if [ "$1" = cd ]; then
    local dir
    dir=$(command tldr --show-paths | sed -n 's/^Custom pages dir:\s*\(.*\)$/\1/p' | sed 's/ (OS convention)$//') || return
    [ -n "$dir" ] || { echo "tealdeer cd: Custom pages dir nicht gefunden" >&2; return 1; }
    mkdir -p "$dir"
    builtin cd "$dir"
  else
    command tldr "$@"
  fi
}

# `nvim cd`: springt in Analogie zu `chezmoi cd` direkt (kein Subshell)
# ins LazyVim-Config-Verzeichnis. Pfad kommt dynamisch von nvim selbst
# (vim.fn.stdpath("config")) statt hartkodiertem ~/.config/nvim, falls
# XDG_CONFIG_HOME mal abweicht. Eigene Wrapper-Funktion statt das echte
# Binary nur bedingt zu überschreiben, da "cd" sonst als (nicht
# existierender) Dateiname an nvim durchgereicht würde.
nvim() {
  if [ "$1" = cd ]; then
    local dir
    dir=$(command nvim --headless +'lua io.write(vim.fn.stdpath("config"))' +qa 2>/dev/null) || return
    builtin cd "$dir"
  else
    command nvim "$@"
  fi
}

# sudo cached standardmäßig PRO TTY (tty_tickets), nicht global pro User -
# jede neue Session hat also eigentlich ihr eigenes, zunächst kaltes Cache,
# selbst wenn woanders gerade eine warme Session offen ist. Der Marker muss
# das nachbilden, sonst zeigt eine frisch eingeloggte Session fälschlich
# warm, nur weil irgendeine andere Session kürzlich sudo benutzt hat. Export,
# damit starships Custom-Modul-Subshell (eigener stdin/stdout, `tty` dort
# ggf. nicht verlässlich) denselben Wert sieht.
export _SUDO_CACHE_TTY="$(tty 2>/dev/null | tr -c 'A-Za-z0-9' '_')"
export _SUDO_CACHE_FILE="$HOME/.cache/sudo-last-used${_SUDO_CACHE_TTY:+.$_SUDO_CACHE_TTY}"

# Merkt sich (rein lesend aus der History, ruft sudo selbst NIE auf) wann
# zuletzt "sudo ..." getippt wurde. Liefert die "~Xm"-Restzeitschätzung für
# [custom.sudo_cache] in starship.toml; ob überhaupt angezeigt wird,
# entscheidet dort mittlerweile `sudo -Nnv` selbst (ground truth), nicht
# mehr diese Datei. Registrierung in PROMPT_COMMAND erfolgt in .bashrc, NICHT
# hier - muss nach "starship init bash" stehen (siehe Kommentar dort).
_track_sudo_use() {
  local last
  read -r last _ <<<"$(fc -ln -1 2>/dev/null)"
  if [ "$last" = "sudo" ]; then
    mkdir -p "$HOME/.cache" 2>/dev/null
    touch "$_SUDO_CACHE_FILE" 2>/dev/null
  fi
}

# _ssh_ports: SSH-Port(s) aus /etc/ssh/sshd_config(.d) (world-readable), Default
# 22. Nimmt `Port N` und `ListenAddress host:N`. Ohne sudo; die autoritative
# Variante (`sshd -T`) braucht root und läuft in _sessions_audit.
_ssh_ports() {
    local p
    p=$( { grep -rhiE '^[[:space:]]*Port[[:space:]]+[0-9]+' \
               /etc/ssh/sshd_config /etc/ssh/sshd_config.d/ 2>/dev/null | awk '{ print $2 }'
           grep -rhiE '^[[:space:]]*ListenAddress[[:space:]].*:[0-9]+[[:space:]]*$' \
               /etc/ssh/sshd_config /etc/ssh/sshd_config.d/ 2>/dev/null \
               | sed -E 's/.*:([0-9]+)[[:space:]]*$/\1/'
         } | sort -un | paste -sd' ' - )
    printf '%s\n' "${p:-22}"
}

# _ss_portfilter <port>...: baut den ss-Ausdruck "( sport = :a or sport = :b )".
_ss_portfilter() {
    local f p
    for p in "$@"; do f="${f:+$f or }sport = :$p"; done
    printf '( %s )\n' "${f:-sport = :22}"
}

# sessions [-a] [port ...]: wie `who`, aber ohne den utmp-Lärm -- obere Hälfte
# zeigt nur echte Logins (lokaler Desktop + SSH) und faltet tmux zu EINER Zeile
# statt einer pro Pane. Nach der "--- ... ---"-Zeile darunter die KERNEL-Sicht
# auf SSH (ss + ps, beide ohne sudo):
#   * die sshd-Session-Prozesse "sshd: user@pts/N" bzw. "...@notty" -- jede wird
#     gegen die pts-Liste aus `who` geprüft und mit "!!" markiert, wenn sie oben
#     fehlt (z.B. "@notty" = PTY-lose Session, für `who` unsichtbar);
#   * Anzahl eingehender established TCP-Sockets auf dem/den SSH-Port(s) + Peer-IPs.
#     Port(s) kommen aus /etc/ssh/sshd_config(.d) (Default 22; die Datei ist
#     world-readable) -- nichts eingeben nötig. Ein oder mehrere Argumente
#     überschreiben die Erkennung: `sessions 22 2222`;
#   * laufende mosh-server (UDP, taucht im SSH-Port-Filter nicht auf).
#
# Warum die untere Hälfte: `who` liest /run/utmp = KOOPERATIVE Buchführung.
# `ssh host cmd` und `ssh -T` (kein PTY -> kein utmp-Eintrag), `ssh -N`,
# scp/sftp, Reverse Shells und alles abseits des PAM-Login-Pfads schreiben
# nichts. ss/ps kommen aus dem Kernel und sehen das. Grenzen/Details:
# ~/Sync/vault/SECOND_BRAIN/CLI-KONSOLENKOMMANDOS-NACHSCHLAGEWERK/who.md
#
# Ohne sudo genügt: fremde sshd-Kinder laufen nach der Privilege-Separation als
# ihr jeweiliger User -> Prozess + geänderter Proctitle bleiben lesbar; nur
# `ss -p` lässt bei fremden Sockets die users:(())-Spalte leer -- daraus
# brauchen wir hier ohnehin nur Peer-IP + Anzahl. awk durchgängig mit
# sub()/split() statt match(s,re,arr) (gawk-only), damit es mit mawk läuft.
#
# `-a` / `--audit` hängt zusätzlich den sudo-pflichtigen Teil an (_sessions_audit):
# `sshd -T` (autoritative Portliste), Auth-Log (auch geschlossene Verbindungen),
# Fehlversuche (lastb), `ss -tnp` mit Prozessspalte. sudo fragt dabei SELBST nach
# dem Passwort -- einmal vorweg (`sudo -v`), damit nicht jedes Kommando einzeln
# fragt; ist der sudo-Cache dieser tty noch warm, kommt gar kein Prompt. Abbruch
# (Ctrl-C / falsches Passwort) -> Audit-Block wird übersprungen, der Rest bleibt.
sessions() {
    local audit=0
    case "$1" in -a|--audit) audit=1; shift ;; esac
    # Port(s): explizite Argumente gewinnen, sonst aus sshd_config (Default 22).
    local ports portdisp
    if [ "$#" -gt 0 ]; then ports="$*"; else ports=$(_ssh_ports); fi
    portdisp=":${ports// /, :}"

    # ── obere Hälfte: echte Logins, tmux gefaltet ──
    who -H | head -n1
    who | awk '
        /\(tmux\([0-9]+\)/ {
            s = $NF
            sub(/^.*\(tmux\(/, "", s)   # -> "<pid>).%<n>)"
            sub(/\).*/,        "", s)   # -> "<pid>"
            panes[s]++
            next
        }
        { print }
        END {
            for (pid in panes)
                printf "%-8s %-12s %s\n", ENVIRON["USER"], "tmux", \
                       "Server " pid ": " panes[pid] " Panes"
        }
    '

    # ── untere Hälfte: Kernel-Sicht auf SSH (ss + ps, ohne sudo) ──
    printf -- '--- aktive SSH-Verbindungen auf %s (ss + ps, ohne sudo) ---\n' "$portdisp"

    # pts-Liste aus who für den Abgleich; LEITUNG kann "sshd pts/1" sein (coreutils
    # 9.7) -> alle Felder scannen statt fix $2.
    local whopts
    whopts=$(who | awk '{ for (i=1;i<=NF;i++) if ($i ~ /^pts\//) print $i }')

    # sshd-Session-Prozesse: Proctitle "sshd: user@pts/N" bzw.
    # "sshd-session: user@notty" (OpenSSH >= 9.8). Zeilen ohne "@" (z.B.
    # "sshd: user [priv]", der root-Monitor) fallen raus.
    local sess
    sess=$(ps -eo args= 2>/dev/null | awk '
        /^sshd(-session)?: / { for (i=1;i<=NF;i++) if ($i ~ /@/) { print $i; break } }' \
        | sort -u)

    if [ -n "$sess" ]; then
        local s tty
        while IFS= read -r s; do
            tty=${s#*@}
            if [ "$tty" = notty ]; then
                printf '  %-24s  !! kein PTY -> nicht in who\n' "$s"
            elif printf '%s\n' "$whopts" | grep -qxF "$tty"; then
                printf '  %-24s  (in who)\n' "$s"
            else
                printf '  %-24s  !! nicht in who\n' "$s"
            fi
        done <<<"$sess"
    else
        printf '  (keine sshd-Session-Prozesse)\n'
    fi

    # eingehende established TCP-Sockets auf dem/den SSH-Port(s) -> Anzahl + Peer-IPs
    # (IPv4-mapped "::ffff:" und IPv6-Klammern normalisiert).
    local ssf peers cnt
    ssf=$(ss -tnH state established "$(_ss_portfilter $ports)" 2>/dev/null)
    cnt=$(printf '%s\n' "$ssf" | grep -c .)
    peers=$(printf '%s\n' "$ssf" | awk 'NF {
                peer = $4
                sub(/:[0-9]+$/, "", peer); gsub(/[][]/, "", peer); sub(/^::ffff:/, "", peer)
                print peer
            }' | sort | uniq -c | awk '{ printf "%s(%s) ", $2, $1 }')
    printf '  %s established Socket(s)%s\n' "${cnt:-0}" "${peers:+ von: ${peers% }}"

    # mosh: UDP-Socket (60000-61000), nicht im :22-Filter oben. `pgrep -c` gibt
    # immer eine Zahl aus (auch "0") und exit!=0 bei 0 Treffern -> kein "|| echo".
    local mosh
    mosh=$(pgrep -cx mosh-server 2>/dev/null)
    [ "${mosh:-0}" -gt 0 ] && printf '  %s mosh-server (UDP, nicht im SSH-Port-Filter)\n' "$mosh"

    if who | grep -qF '(tmux('; then
        _hinweis "tmux-Detail: 'tmux ls' bzw. 'tmux list-panes -a'"
    fi

    [ "$audit" -eq 1 ] && _sessions_audit $ports
}

# _sessions_audit <port>...: der sudo-pflichtige Teil von `sessions -a`. Ruft sudo
# selbst auf (ein `sudo -v` vorweg bündelt den Passwort-Prompt). Bricht sauber
# ab, wenn kein sudo (kein Passwort / kein tty). `sed 's/^/    /'` rückt jeden
# Block ein; leere Blöcke bleiben leer (self-explanatory). Die auth.log-Zeilen
# laufen durch _reltime_prefix -> rsyslog-ISO-Stempel wird "vor X Min." (git-hs-
# Stil) + nackte Uhrzeit. `sshd -T` liefert die AUTORITATIVE Portliste (effektive
# Config, nicht nur die Datei) -> wenn sie von der übergebenen abweicht, wird das
# gezeigt und ab da diese benutzt.
_sessions_audit() {
    local ports="${*:-22}"
    printf -- '--- Audit (sudo: sshd -T + Auth-Log + Fehlversuche + ss -p) ---\n'
    if ! sudo -v 2>/dev/null; then
        printf '  (kein sudo -> Audit übersprungen)\n'
        return 1
    fi

    local realports
    realports=$(sudo sshd -T 2>/dev/null | awk '$1 == "port" { print $2 }' | paste -sd' ' -)
    if [ -n "$realports" ]; then
        printf '  sshd -T Port(s): %s%s\n' "$realports" \
               "$( [ "$realports" != "$ports" ] && printf '   (sessions nutzte: %s)' "$ports" )"
        ports="$realports"
    else
        printf '  sshd -T Port(s): ? (nutze: %s)\n' "$ports"
    fi

    printf '  letzte SSH-Logins/-Trennungen (auth.log):\n'
    local raw
    if sudo test -f /var/log/auth.log; then
        raw=$(sudo grep -aE 'sshd[^:]*:[^:]*(Accepted |Failed password |Invalid user |Disconnected from |Connection closed by )' \
              /var/log/auth.log | tail -n 20)
    else
        raw=$(sudo journalctl -q _COMM=sshd -o short-iso --no-pager 2>/dev/null | tail -n 20)
    fi
    if [ -z "$raw" ]; then
        printf '    (nichts / weder auth.log noch journalctl)\n'
    else
        printf '%s\n' "$raw" | _reltime_prefix | sed 's/^/    /'
    fi

    printf '  Fehlversuche (btmp, neueste 10):\n'
    if command -v lastb >/dev/null && sudo test -f /var/log/btmp; then
        sudo lastb -n 10 | sed 's/^/    /'
    else
        printf '    (kein btmp)\n'
    fi

    printf '  established Sockets auf %s mit Prozess:\n' ":${ports// /, :}"
    sudo ss -tnp state established "$(_ss_portfilter $ports)" | sed 's/^/    /'
}

# _reltime_prefix: liest Zeilen von stdin, deren ERSTES Feld ein Zeitstempel ist
# (rsyslog-ISO "2026-09-03T10:14:07.8+02:00" oder journalctl short-iso), und
# ersetzt diesen Stempel durch eine relative Angabe im Stil von `git hs`
# ("vor 38 Min.") plus die nackte Uhrzeit. Alle Stempel werden mit EINEM
# `date -f -` in Epochen gewandelt, nicht pro Zeile. Zeilenzahl-Mismatch (z.B.
# date stolpert über eine Zeile) oder fehlendes date -> Eingabe unverändert
# durchreichen. Schwellen/Rundung wie git (date.c show_date_relative).
_reltime_prefix() {
    local data epochs now nd ne
    data=$(cat)
    [ -z "$data" ] && return 0
    now=$(date +%s)
    epochs=$(printf '%s\n' "$data" | awk '{ print $1 }' | date -f - +%s 2>/dev/null)
    nd=$(printf '%s\n' "$data"   | grep -c .)
    ne=$(printf '%s\n' "$epochs" | grep -c .)
    if [ -z "$epochs" ] || [ "$nd" != "$ne" ]; then
        printf '%s\n' "$data"
        return 0
    fi
    paste <(printf '%s\n' "$epochs") <(printf '%s\n' "$data") | awk -F'\t' -v now="$now" '
        function rel(e,   s, m, h, d) {
            s = now - e; if (s < 0) s = 0
            if (s < 90)                      return "vor " s " Sek."
            m = int((s + 30) / 60);     if (m < 90)  return "vor " m " Min."
            h = int((s + 1800) / 3600); if (h < 36)  return "vor " h " Std."
            d = int((s + 43200) / 86400); if (d < 14) return "vor " d " Tg."
            if (d < 70)  return "vor " int((d + 3) / 7)   " Wo."
            if (d < 365) return "vor " int((d + 15) / 30) " Mon."
            return "vor " int((d + 182) / 365) " J."
        }
        {
            iso = $2; sub(/ .*/, "", iso)
            clock = iso; sub(/.*T/, "", clock); sub(/[.+-].*/, "", clock)
            line = $2; sub(/^[^ ]+ /, "", line)
            printf "%-12s %s  %s\n", rel($1 + 0), clock, line
        }'
}
