if [ -x /usr/bin/dircolors ]; then
  test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
fi

# ══════════════════════════════════════════════════════════════════
# ALIASE
# ══════════════════════════════════════════════════════════════════

# Grep-Aliase
alias grep='grep --color=auto'      # grep-Treffer farbig hervorheben
alias fgrep='grep -F --color=auto'  # fixed-string grep, ebenfalls farbig
alias egrep='grep -E --color=auto'  # extended grep, ebenfalls farbig
alias rgrep='grep -r --color=auto'  # extended grep, ebenfalls farbig

# Praktische ls-Kurzformen
alias ls='ls --color=auto'        # ls mit Farben
alias ll='ls -lh'                 # lange Auflistung, menschenlesbare Größen
alias la='ls -A'                  # alle Dateien außer . und ..
alias l='ls -CF'                  # kompakte Spaltenansicht mit Typkennzeichen

# sudo-Trick: erlaubt Expansion eigener Aliase auch nach "sudo"
alias sudo='sudo '

# glow mit Pager
alias glowp='glow -p'

# ══════════════════════════════════════════════════════════════════
# HINWEISE (einheitliche "Info:"-Ausgabe für Funktionen wie findgrep, fd, ...)
# ══════════════════════════════════════════════════════════════════

# _hinweis_onecol <text>: <text> als einzeilige "═══ Info: ... ═══" Badge auf
# stderr, mit ═ symmetrisch bis maxwidth aufgefüllt (statt fixer 8er-Ränder).
# Kein Umbruch -- nur für kurze Texte gedacht, wird von _hinweis automatisch
# gewählt.
_hinweis_onecol() {
    local text="$1" maxwidth=60
    local c_dim='' c_cyan='' c_off=''
    [[ -t 2 ]] && { c_dim=$'\033[2m'; c_cyan=$'\033[36m'; c_off=$'\033[0m'; }

    # Feste Bestandteile ohne Rand: " Info: " + Text + " " (je ein
    # Leerzeichen um das Label und vor dem rechten Rand). Rest wird
    # symmetrisch mit ═ aufgefüllt, überzähliges Zeichen bei Ungerade an
    # den rechten Rand.
    local label="Info:"
    local fixed_len=$(( 1 + ${#label} + 1 + ${#text} + 1 ))
    local border_total=$(( maxwidth - fixed_len ))
    (( border_total < 2 )) && border_total=2
    local left=$(( border_total / 2 ))
    local right=$(( border_total - left ))
    local lborder rborder
    lborder=$(printf '═%.0s' $(seq 1 "$left"))
    rborder=$(printf '═%.0s' $(seq 1 "$right"))

    printf '%s%s %sInfo:%s%s %s %s%s\n' \
        "$c_dim" "$lborder" "$c_off$c_cyan" "$c_off" "$c_dim" "$text" "$rborder" "$c_off" >&2
}

# _hinweis_multicol <text>: <text> als Block auf stderr -- Kopfzeile trägt das
# "Info:"-Label direkt im Rand ("═ Info: ═══..."), Text darunter an
# Wortgrenzen auf maximal 60 Zeichen/Zeile umgebrochen (fold -s), Fußzeile
# reiner ═-Rand. Für Texte, die einzeilig (_hinweis_onecol) zu breit würden.
_hinweis_multicol() {
    local text="$1" maxwidth=60
    local c_dim='' c_cyan='' c_off=''
    [[ -t 2 ]] && { c_dim=$'\033[2m'; c_cyan=$'\033[36m'; c_off=$'\033[0m'; }

    # printf '═%.0s' $(seq 1 N): bewährte Bash-Idiom für N-fache Wiederholung
    # eines Strings -- "tr ' ' '═'" scheitert hier, weil tr Mehrbyte-UTF-8-
    # Zeichen (═ = 3 Byte) nicht korrekt ersetzt.
    #
    # Kopfzeile: minimales Gerüst "═ Info: ═", danach mit ═ bis maxwidth
    # aufgefüllt statt einer vom Label unabhängigen fixen Rahmenbreite.
    local label="Info:"
    local head="═ ${label} "
    local fill_len=$(( maxwidth - ${#head} ))
    (( fill_len < 1 )) && fill_len=1
    local fill
    fill=$(printf '═%.0s' $(seq 1 "$fill_len"))

    local border
    border=$(printf '═%.0s' $(seq 1 "$maxwidth"))

    {
        printf '%s═ %s%s%s%s %s%s\n' "$c_dim" "$c_off$c_cyan" "$label" "$c_off" "$c_dim" "$fill" "$c_off"
        fold -s -w "$maxwidth" <<<"$text"
        printf '%s%s%s\n' "$c_dim" "$border" "$c_off"
    } >&2
}

# _hinweis <text>: einheitlicher Info-Hinweis auf stderr. Wählt automatisch
# zwischen einzeiliger Badge (_hinweis_onecol) und mehrzeiligem Block
# (_hinweis_multicol) -- je nachdem, ob <text> mit dem MINIMALEN Onecol-Rand
# ("═ Info: " davor, " ═" danach -- _hinweis_onecol füllt selbst bis 60 auf)
# einzeilig unter 60 Zeichen bleiben würde.
_hinweis() {
    local text="$1"
    local minimal_prefix="═ Info: "
    local minimal_suffix=" ═"
    if (( ${#minimal_prefix} + ${#text} + ${#minimal_suffix} > 60 )); then
        _hinweis_multicol "$text"
    else
        _hinweis_onecol "$text"
    fi
}

