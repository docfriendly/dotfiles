{{- $machine := index .machines .chezmoi.hostname -}}
{{- if not $machine -}}
{{   fail (printf "dot_tmux.conf.tmpl: unbekannter Hostname %q - bitte Eintrag in .chezmoidata.yaml unter machines.%s ergaenzen" .chezmoi.hostname .chezmoi.hostname) }}
{{- end -}}
# Set the prefix to Ctrl+y
# Remove the old prefix
# Send Ctrl+s to applications by pressing it twice
set -g prefix C-Space
unbind C-b
bind C-Space send-prefix

# tmux >= v2.1
set -g mouse on # mit Mausoption: Einfügen mtlr. Maustaste auf einmal nicht mehr möglich

# 3.4 copy support
set-window-option -g allow-passthrough on

# Highlight active window
#set-window-option -g window-status-current bg=red # -> TODO: Verursacht Fehler

# Style color preferences
set -g status-bg {{ $machine.tmux.statusBg }}
set -g window-status-style bg=yellow
set -g window-status-current-style bg=red,fg=white

# List of plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'tmux-plugins/tmux-resurrect'

# Restart processes with resurrect-plugin
set -g @resurrect-processes '{{ $machine.tmux.resurrectProcesses }}'

# Other examples:
# set -g @plugin 'github_username/plugin_name'
# set -g @plugin 'github_username/plugin_name#branch'
# set -g @plugin 'git@github.com:user/plugin'
# set -g @plugin 'git@bitbucket.com:user/plugin'

# Save scrollback buffer to file (Prefix + S)
bind S run-shell 'tmux capture-pane -S - && tmux save-buffer ~/tmux-session-$(date +%Y-%m-%d-%H%M%S).txt && tmux display-message "Buffer gespeichert: ~/tmux-session-$(date +%Y-%m-%d).txt"'

# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run '~/.tmux/plugins/tpm/tpm'
