# .uuid wird nicht vom Nerd-Fonts-Archiv geliefert, sondern extern (root-Prozess,
# vermutlich xdg-desktop-portal/Flatpak beim Bereitstellen des Font-Verzeichnisses)
# bei jedem Zugriff neu angelegt. Unter "exact = true" (.chezmoiexternal.toml) würde
# chezmoi sie bei jedem apply löschen wollen und wegen der ständig neuen, unerwarteten
# Version interaktiv nachfragen - das blockiert nicht-interaktive Läufe.
.local/share/fonts/NerdFonts/JetBrainsMono/.uuid

# tmux-server-Autostart startet tmux headless beim Login, damit
# tmux-continuum/-resurrect (@continuum-restore) nach einem unsauberen
# Neustart automatisch greift - siehe SECOND_BRAIN/x220-forensics-unplanned-restart/BERICHT.md.
# Bewusst nur auf x220, wo die unsauberen Neustarts beobachtet wurden.
{{- if ne .chezmoi.hostname "x220" }}
.config/autostart/tmux-server.desktop
{{- end }}

# Barrier-Server-Config: nur x230 laeuft als Barrier-Server (Tastatur/Maus-Quelle).
# x220 nutzt Deskflow, kartoffel ist nur Client - dort waere die Datei sinnlos.
# Siehe SECOND_BRAIN/deskflow-barrier-rollentausch/BERICHT_deskflow-barrier-rollentausch.md
{{- if ne .chezmoi.hostname "x230" }}
.config/barrier
{{- end }}

# kvm-rolle-Autostart (Rollentausch-Verbund): definierter Startzustand nur auf
# x220 (-> Client von x230). x230 startet Barrier weiter ueber XFCE-Session-
# Restore; ein zweiter Autostart wuerde barriers doppelt starten.
{{- if ne .chezmoi.hostname "x220" }}
.config/autostart/kvm-rolle.desktop
{{- end }}
