{{- $machine := index .machines .chezmoi.hostname -}}
{{- if not $machine -}}
{{   fail (printf "dot_tmux.conf.tmpl: unbekannter Hostname %q - bitte Eintrag in .chezmoidata.yaml unter machines.%s ergaenzen" .chezmoi.hostname .chezmoi.hostname) }}
{{- end -}}
# Set the prefix to Ctrl+y
# Remove the old prefix
# Send Ctrl+s to applications by pressing it twice
set -g prefix C-Space
unbind C-b
bind C-Space send-prefix

# tmux >= v2.1
set -g mouse on # mit Mausoption: Einfügen mtlr. Maustaste auf einmal nicht mehr möglich

# 3.4 copy support
set-window-option -g allow-passthrough on

# Neue Panes/Windows im cwd des aktuellen Panes statt im ursprünglichen Startverzeichnis öffnen
bind '"' split-window -v -c "#{pane_current_path}"
bind %   split-window -h -c "#{pane_current_path}"
bind c   new-window -c "#{pane_current_path}"

# Highlight active window
#set-window-option -g window-status-current bg=red # -> TODO: Verursacht Fehler

# Style color preferences
set -g status-bg {{ $machine.tmux.statusBg }}
set -g window-status-style bg=yellow
set -g window-status-current-style bg=red,fg=white

# tmux' Default (40) reicht am Laptop nicht mehr: seit iphone-mode.sh den
# Pane-Titel dort auf feste Breite 21 auffüllt, ist der Text vor dem
# W-Knopf konstant 40 Zeichen lang -- der Knopf selbst (3 weitere Zeichen)
# wurde dadurch komplett abgeschnitten (Fund 19.08.2026).
set -g status-right-length 50

# Plugins nach ~/.config/tmux/plugins statt ins alte ~/.tmux ablegen
set-environment -g TMUX_PLUGIN_MANAGER_PATH '{{ .chezmoi.homeDir }}/.config/tmux/plugins/'

# List of plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'nhdaly/tmux-better-mouse-mode'

# tmux-better-mouse-mode: Mausrad-Scrollen weniger ruckelig (Default 3 Zeilen/Tick)
# und in Vollbild-Programmen (vim, less, man) Scroll-Events als Pfeiltasten/
# PageUp statt Copy-Mode durchreichen (siehe Termius-Scroll-Recherche, 20.08.2026).
set -g @scroll-speed-num-lines-per-scroll "1"
set -g @emulate-scroll-for-no-mouse-alternate-buffer "on"

# Restart processes with resurrect-plugin
set -g @resurrect-processes '{{ $machine.tmux.resurrectProcesses }}'

# Auto-Save/-Restore per continuum-plugin (Session-Daten bleiben lokal pro Maschine)
set -g @continuum-restore 'on'

# Nach jedem Restore (auch dem automatischen per continuum): fuer Panes mit
# noch sichtbarem altem Claude-Code-Fenstertitel automatisch den passenden
# "claude --resume <id>"-Befehl eintippen, statt manuell durch die Resume-
# Liste suchen zu muessen. Siehe Skript-Kommentar fuer Details/Verifikation.
set -g @resurrect-hook-post-restore-all '{{ .chezmoi.homeDir }}/.local/bin/claude-tmux-resurrect-resume'

# Other examples:
# set -g @plugin 'github_username/plugin_name'
# set -g @plugin 'github_username/plugin_name#branch'
# set -g @plugin 'git@github.com:user/plugin'
# set -g @plugin 'git@bitbucket.com:user/plugin'

# Save scrollback buffer to file (Prefix + S)
bind S run-shell 'tmux capture-pane -S - && tmux save-buffer ~/tmux-session-$(date +%Y-%m-%d-%H%M%S).txt && tmux display-message "Buffer gespeichert: ~/tmux-session-$(date +%Y-%m-%d).txt"'

# Gesamtes tmux-Pane-Scrollback (nicht nur der aktuell sichtbare kitty-
# Screen) durchsuchbar in einem Popup oeffnen (Prefix + [). Ersetzt tmux'
# eingebauten copy-mode-Einstieg auf dieser Taste. Kein Nvim-Plugin noetig
# (Ersatz fuer kitty-scrollback.nvim, dessen tmux-Support in v9.0.0 entfernt
# wurde) -- nur tmux capture-pane + normales Neovim im Read-only-Modus.
# Laeuft komplett auf der Maschine, auf der der tmux-Server laeuft, also
# auch unveraendert innerhalb einer SSH-Session (kein kitty-Remote-Control).
# WICHTIG: $F muss als \$F escaped werden -- tmux' Config-Parser interpretiert
# unescaptes $NAME in "..."-Strings selbst als (hier nicht existierende)
# Server-Umgebungsvariable und ersetzt es beim Laden/source-file durch "",
# lange bevor die Shell das Skript sieht. Ohne Escaping schreibt capture-pane
# dann in eine leere Datei und "term cat" laeuft ohne Argument -- ein
# leeres, wartendes nvim-Fenster (empirisch verifiziert, 26.08.2026).
bind [ run-shell "F=/tmp/tmux-scrollback.$$; tmux capture-pane -peS - -t #{pane_id} > \"\$F\"; tmux display-popup -E -w 90% -h 90% -T 'tmux-Scrollback durchsuchen' \"nvim -c 'set nolist nonumber signcolumn=no' -c 'term cat \$F' -c 'au TermClose * ++once stopinsert'; rm -f \$F\""

# Termius (iPhone 12 mini) meldet sich per SSH-Env-Var IPHONE_CLIENT=true (siehe sshd_config AcceptEnv).
# Bei jedem Client-Attach in die Session-Umgebung übernehmen und Statusleiste bei Bedarf nach oben legen,
# weil Termius' eigene UI/Tastatur sonst die unterste Zeile verdeckt.
set -g update-environment "DISPLAY KRB5CCNAME MSYSTEM SSH_ASKPASS SSH_AUTH_SOCK SSH_AGENT_PID SSH_CONNECTION WAYLAND_DISPLAY WINDOWID XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE IPHONE_CLIENT"
set-hook -g client-attached 'run-shell "{{ .chezmoi.homeDir }}/.config/tmux/iphone-mode.sh"'
# Auch bei reinem Session-Wechsel (choose-session, ohne Neuverbinden) neu ausführen --
# sonst bleibt die dynamisch aus dem Session-Namen berechnete Kasten-Breite im
# Session-Knopf links auf dem Stand der zuvor aktiven Session stehen.
set-hook -g client-session-changed 'run-shell "{{ .chezmoi.homeDir }}/.config/tmux/iphone-mode.sh"'
# Auch bei Layout-Aenderungen (u.a. Zoom per Prefix+z) neu ausfuehren, damit die
# Fenster-Tab-Breite im Laptop-Zweig sofort neu berechnet wird, statt erst beim
# naechsten Attach/Session-Wechsel -- empirisch verifiziert (19.08.2026, Scratch-
# Session), dass window-layout-changed zuverlaessig bei -Z feuert. Ersetzt NICHT
# den statischen +1-Puffer in iphone-mode.sh (Guertel und Hosentraeger: mehrere
# schnell aufeinanderfolgende Layout-Events beim Ziehen einer Pane-Grenze koennten
# sonst kurzzeitig eine zu schmale Box zeigen).
set-hook -g window-layout-changed 'run-shell "{{ .chezmoi.homeDir }}/.config/tmux/iphone-mode.sh"'

# Zwei antippbare Bereiche in der Statusleiste (harmlos auch außerhalb des
# iPhone-Modus, da dort mit der Maus kaum geklickt wird):
# - S-Knopf rechts (status-right) -> Fenster-Auswahl (choose-window)
# - Session-Namen-Kasten links (status-left) -> Session-Auswahl (choose-session)
bind-key -T root MouseDown1StatusRight choose-window
bind-key -T root MouseDown1StatusLeft choose-session

# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run '{{ .chezmoi.homeDir }}/.config/tmux/plugins/tpm/tpm'
