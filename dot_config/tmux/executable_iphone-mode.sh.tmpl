#!/bin/bash
# Bei jedem Client-Attach/Session-Wechsel aufgerufen (client-attached- und
# client-session-changed-Hook in tmux.conf). Erkennt Termius/iPhone per
# IPHONE_CLIENT-Session-Env-Var (siehe ../../termius-iphone-tmux-env-var-krimi/
# BERICHT_*.md) und stellt die Statuszeile entsprechend um.
#
# WICHTIG: Beide Zweige (iPhone/Laptop) setzen JEDE betroffene Option immer
# explizit neu -- keiner verlässt sich auf einen Vorzustand. Grund: eine
# frühere Version hatte einen else-Zweig, der z.B. status-left und
# status-format[1] nie zurücksetzte -- beim Wechsel iPhone->Laptop blieben so
# Boxen-Reste vom iPhone-Zweig hängen (Symptom: zwei Zeilen, aber
# status-position bottom -- eine Mischung aus beiden Zweigen).

# Guard gegen PiP-Wegwerf-Sessions (siehe tmux-config-popup/):
# ein PiP-Popup macht innen ein echtes tmux attach-session auf eine "_pip"-
# Session -> loest global den client-attached-Hook aus und wuerde hier sonst
# die Kasten-Breiten (z.B. status-left) anhand der 4 Zeichen "_pip" statt der
# echten Session neu berechnen -- global gesetzt, reisst dadurch die
# Statuszeile der echten Session sichtbar auseinander.
case "$(tmux display-message -p '#{session_name}')" in
  _pip*) exit 0 ;;
esac

# Zweite Erkennung (Experiment, 23.09.2026): Client-Breite <= IPHONE_MAX_COLS
# (Termius auf dem iPhone 12 mini: 76 Spalten bei kleinster Schrift). Gleicher
# Wert wie `tput cols` in der Client-Shell -- im run-shell-Hook gibt es aber
# kein TTY (tput lieferte dort den Fallback 80), daher #{client_width}.
# ODER-verknüpft mit der Env-Var; zum Abschalten IPHONE_MAX_COLS=0 setzen.
IPHONE_MAX_COLS=76
_client_w="$(tmux display-message -p '#{client_width}' 2>/dev/null)"
_narrow=false
[ "${_client_w:-999}" -le "$IPHONE_MAX_COLS" ] 2>/dev/null && _narrow=true

if [ "$(tmux show-environment IPHONE_CLIENT 2>/dev/null)" = "IPHONE_CLIENT=true" ] || $_narrow; then
  _iphone=true
  tmux set -g status-position top
  # iPhone: schmaler Touch-Screen -> feste, kompakte Innenbreite, Name hart
  # gekürzt. 8 = 7 Zeichen Name + Ellipse. PiP-Marker, Zoom-Lupe und die
  # Flags ("*"/"-"/"M") sitzen seit 05.10.2026 komplett oben in Zeile 1 (s.
  # _pip_marker/_zoom_marker/_flags_marker weiter oben) und brauchen hier
  # keinen Platz mehr -- die dadurch freien 3 Zellen gehen direkt an
  # _name_trunc (vorher 4).
  _tab_w=8
  _marker_w=2
  _flags_w=2
  _name_trunc=7
  _scroll_speed=1
else
  _iphone=false
  tmux set -g status-position bottom
  # Laptop: feste, kompakte Innenbreite statt dynamisch aus dem längsten
  # offenen Fensternamen berechnet (frühere Version, s. Git-History) --
  # ein einziger langer Ausreißer (z.B. "kartoffel-olivetin", 18 Zeichen)
  # zog die Box sonst für ALLE Fenster unnötig breit und STM/Chezmoi &Co.
  # wirkten dadurch nicht mehr zentriert (Fund 19.08.2026, zweite Runde).
  # 13 Zeichen Name + Ellipse = 14 -- deckt kurze/mittlere Namen (STM,
  # c-tmux, sh-STM, Chezmoi) exakt ab, längere werden gekürzt. PiP-Marker,
  # Zoom-Lupe und die Flags ("*"/"-"/"M") sitzen seit 05.10.2026 komplett
  # oben in Zeile 1 (s. _pip_marker/_zoom_marker/_flags_marker weiter oben)
  # und brauchen hier keinen Platz mehr -- die dadurch freien 3 Zellen gehen
  # direkt an _name_trunc (vorher 10).
  _tab_w=14
  # Marker-/Flag-Bereich hier 3 statt 2 breit: ▶ (PiP, 1 Zelle) + 🔍 (Zoom,
  # 2 Zellen) zusammen = 3 -- bei 2 lief Zeile 1 um 1 Zelle ueber und das
  # "┐" sass versetzt zum "┘" (Fund 06.10.2026, nc-fax: gezoomtes PiP-Fenster).
  # iPhone-Zweig bleibt bei 2 (zu schmal fuer mehr).
  # 08.10.2026: Link-Glyph steht NICHT mehr hier, sondern direkt hinter der
  # Nummer (s. _shared_marker/window-status-format) -- ▶ + 🔍 + Glyph = 4 sprengten
  # die 3 (z.B. DEV:2 "masq": PiP-verknuepft, geteilt und gezoomt).
  _marker_w=3
  _flags_w=3
  _name_trunc=13
  _scroll_speed=3
fi

# Mausrad-Scrolltempo: iPhone/Termius 1 Zeile/Tick (smooth-Alternative fehlt
# dort, aber 1 ist wenigstens ertraeglich), Laptop der tmux-better-mouse-mode-
# Default 3 Zeilen/Tick (am Touchpad sonst zu langsam). Die Option allein
# reicht nicht: das Plugin baut seine Wheel-Bindings beim Laden fest aus dem
# damaligen Optionswert zusammen (siehe scroll_copy_mode.tmux) -- ein reines
# "tmux set" hier würde also ohne Neustart der ganzen tmux-Session wirkungslos
# bleiben. Deshalb Option setzen UND das Plugin-Script hier erneut ausführen,
# damit es die Bindings mit dem neuen Wert neu erzeugt.
tmux set -g @scroll-speed-num-lines-per-scroll "$_scroll_speed"
"{{ .chezmoi.homeDir }}/.config/tmux/plugins/tmux-better-mouse-mode/scroll_copy_mode.tmux"
unset _scroll_speed

tmux set -g status 2

# Zentrieren geht nur über Verschachtelung #{pN:#{p-M:inhalt}} (erst
# rechtsbündig auf Breite M polstern, dann linksbündig auf die
# Gesamtbreite N -- ergibt näherungsweise zentrierten Text, siehe Bericht).
# Echtes Pixel-genaues Zentrieren PRO Fenster ist nicht möglich (gleicher
# Grund wie bei der Breite: tmux wertet window-status-format intern pro
# Fenster aus, Bash kennt die einzelne Inhaltslänge vorher nicht) -- M ist
# also zwangsläufig ein für ALLE Fenster gemeinsamer Kompromisswert. Der
# Name (Zeile 2) wird bewusst NICHT zentriert, nur linksbündig gekürzt
# (Fund 19.08.2026, s. Kommentar weiter unten) -- M wird daher nur noch fuer
# die Nummer in Zeile 1 gebraucht (s. _num_center_m weiter unten, berechnet
# aus _num_area_w statt _tab_w, weil Marker links und Flags rechts seit
# 05.10.2026 je einen festen Teil der Box-Innenbreite reservieren).

# Fenster-Tabs: oben nur die Nummer (zentriert), unten Name (gekürzt) +
# Flags, linksbündig (Fund 19.08.2026: Zentrierung des Namens verworfen --
# ab Namenslänge >= center_m rutscht sie ohnehin bündig nach links, s.
# Bericht). Beide Zeilen auf dieselbe Innenbreite gepolstert, damit die
# Box-Ecken übereinanderstehen.
# PiP-Verknuepfung (Fenster-Option @pip_target, siehe tmux-pip-toggle.sh):
# ganze Box in einer eigenen Farbe einfaerben (statt nur ein leicht zu
# uebersehendes Zeichen). Nur im NICHT-aktiven Zweig -- das aktive Fenster
# soll weiterhin rot bleiben (Vorrang vor der Verknuepfungsfarbe), der
# Marker (s. _pip_marker weiter unten) zeigt die Verknuepfung dort trotzdem
# an. Komma im verschachtelten #[...] muss als "#," escaped werden (gleiches
# Muster wie window_offset_x/-y weiter unten in dieser Datei).
# "__unlinked__" ist der Sentinel-Wert aus tmux-pip-toggle.sh (Prefix+u):
# bewusst getrennt, aber @pip_target ist trotzdem nicht leer -- ohne diese
# Sonderbehandlung wuerde die Box faelschlich weiter cyan/▶ zeigen, obwohl
# keine echte Verknuepfung mehr besteht.
_pip_prefix="#{?#{==:#{@pip_target},__unlinked__},,#{?@pip_target,#[bg=cyan#,fg=black],}}"

# PiP-Marker "▶", Zoom-Lupe 🔍, Fenster-geteilt-Marker 🔗 und die Flags
# "*"/"-"/"M" (05.10.2026 komplett aus Zeile 2/Name nach Zeile 1/Nummer
# verschoben -- dort ist unten mehr Platz fuer den Namen, und oben fallen
# alle Zustaende schneller auf). Die Box-ECKEN "┌"/"┐" bleiben dabei bewusst
# UNVERAENDERT (Wunsch 05.10.2026) -- PiP/Zoom/🔗 stehen links direkt nach
# "┌" (mit einem zusaetzlichen Leerzeichen Abstand davor, besser sichtbar),
# die Flags rechts direkt vor "┐" (Wunsch 05.10.2026: rechter statt linker
# Rand, damit sich die beiden Gruppen nicht gegenseitig in die Quere
# kommen; dort ebenfalls 1 Zeichen Abstand DAHINTER -- also spiegelbildlich
# "┌ ..." / "... ┐" --, nicht davor, sonst klebt das Flag-Zeichen direkt an
# "┐", Fund 05.10.2026).
#
# 🔗 (Wunsch 05.10.2026): tmux' natives window_linked -- 1, wenn das Fenster
# per "link-window" in mehr als einer Session haengt (z.B. DEV:1 "LOGS",
# das zugleich in STM-SERVER haengt). Bewusst OHNE Faelle, in denen das nur
# an unserem eigenen PiP-Mechanismus liegt: tmux-pip-toggle.sh linkt das
# Fenster waehrend das Popup offen ist ebenfalls per "link-window" in die
# Session "_pip" -- window_linked waere in dem Moment also ebenso 1, obwohl
# dafuer schon _pip_marker/_pip_prefix zustaendig sind. Deshalb zusaetzlich
# ueber window_linked_sessions_list gegen "*_pip*" gematcht und in dem Fall
# unterdrueckt, sonst stuenden ▶ und 🔗 fuer denselben Vorgang doppelt da.
#
# Breiten-Aufteilung der Box-Innenbreite _tab_w, damit sie IMMER exakt
# _tab_w breit bleibt (unabhaengig davon, ob/wie viele Marker/Flags gerade
# gezeigt werden -- sonst waeren Zeile 1 und Zeile 2 unterschiedlich breit
# und die Box-Ecken stuenden nicht mehr uebereinander, s. Kommentar oben):
# 1 Zeichen Leerzeichen nach "┌" + _marker_w fuer PiP/Zoom/🔗 (links-
# buendig gepolstert, FESTE Breite -- wichtig, damit die Nummer danach
# IMMER an derselben Spalte startet und sich wirklich zentrieren laesst,
# unabhaengig davon ob gerade ein Marker gezeigt wird) + _num_area_w fuer
# die zentrierte Nummer + _flags_w fuer die Flags (rechtsbuendig gepolstert)
# + 1 Zeichen Leerzeichen vor "┐". _marker_w UND _flags_w bewusst GLEICH
# (beide 2) gewaehlt, nicht nur weil 2 fuer die Flags reicht, sondern damit
# linker Ueberhang (1 Leerzeichen + _marker_w) und rechter Ueberhang
# (_flags_w + 1 Leerzeichen) gleich gross sind -- nur so landet die Nummer
# wirklich in der Mitte der GESAMTEN Box (Fund 05.10.2026: mit _marker_w=3
# bei weiterhin _flags_w=2 war die Box links 1 Zeichen "schwerer", die Zahl
# rutschte sichtbar nach rechts). _marker_w=2 reicht fuer PiP/Zoom/🔗 EINZELN
# -- mehrere gleichzeitig (seltener Edge-Case, z.B. ein gezoomtes PiP-
# Fenster) koennen minimal ueberlaufen, genau wie bei den Flags unten.
_num_area_w=$(( _tab_w - _marker_w - _flags_w - 2 ))
_num_center_m=$(( (_num_area_w + 1) / 2 ))
_pip_marker="#{?#{==:#{@pip_target},__unlinked__},,#{?@pip_target,▶,}}"
_zoom_marker="#{?window_zoomed_flag,🔍,}"
# 🔗 ist ein Farb-Emoji und nimmt keine fg-Farbe an (auf Flieder/Petrol kaum zu
# sehen, Wunsch 08.10.2026) -> Nerd-Font-Glyph U+F0C1 (nf-fa-link, 1 Zelle breit,
# einfarbig), erbt die Textfarbe der Box (schwarz auf Claude-/PiP-Hintergrund).
# Ein explizites #[fg=black] samt push-default/pop-default ist NICHT drin: die
# Statuszeile wird in einem Zug gezeichnet, der gesetzte Default schlug auf alle
# Tabs hinter dem ersten verlinkten Fenster durch (Fund 08.10.2026, AGENTS ab 5).
_shared_marker="#{?window_linked,#{?#{m:*_pip*,#{window_linked_sessions_list}},,},}"
# Das hartkodierte "Z" aus #{window_flags} (tmux haengt es selbst an, siehe
# window.c, window_printable_flags(): flags[pos++]='Z' -- dafuer gibt es
# KEINE Option) wird per s/Z// entfernt, sonst stuende es doppelt da (einmal
# als 🔍 links, einmal als rohes "Z" rechts).
_flags_marker="#{s/Z//:window_flags}"

# Claude-Code-Status: Farbe kommt NICHT aus Claude Codes OSC-Fenstertitel --
# eine erste Version verliess sich darauf, dass der Titel busy ("◐"/"◑") von
# wartet ("✳ <Titel>") unterscheidet (so von einer GitHub-Issue-Recherche
# behauptet), das ist aber empirisch falsch: die eigene Pane zeigte waehrend
# aktiver Arbeit weiterhin "✳", nie einen Spinner-Glyphen (widerlegt
# 21.09.2026, eigene Session live gegengeprueft). Stattdessen schreiben
# Claude-Code-Hooks (UserPromptSubmit/PreToolUse -> busy, Stop/Notification
# -> wartet, siehe ~/Sync/vault/claude/settings.json + Skript
# executable_claude-pane-status-hook) den Zustand direkt in eine Datei unter
# ~/.cache/claude-tmux-status/<pane-id>. claude-pane-status-color.sh liest
# das fuer ALLE Panes des Fensters (nicht nur die aktive -- ein Split-
# Fenster mit fokussierter Nicht-Claude-Pane zeigte sonst faelschlich gar
# keinen Status, obwohl eine andere Pane im selben Fenster wartet, Fund
# 21.09.2026, AGENTS:7) und gibt den passenden #[bg=...]-Praefix aus (busy
# hat Vorrang, falls mehrere Claude-Panes im Fenster unterschiedliche
# Zustaende haben). Dateibasiert statt in tmux' Format-Sprache nachgebaut --
# ein erster Versuch rein in Format-Sprache (P-Loop + verschachtelte
# Ternaries) hat tmux' Klammerzaehlung gesprengt (leerer Ausdruck, 21.09.2026).
#
# Volle Hintergrundfarbe (wie beim PiP-Cyan-Trick) statt nur Textfarbe: ein
# gruener Text auf dem gelben Standard-Boxhintergrund war praktisch
# unlesbar (Fund 21.09.2026). Mauve (colour175) = Claude arbeitet, Salbeigruen
# (colour108) = Claude wartet auf Eingabe (= "hier brauchts dich") --
# bewusst keine Orange-/Neongruentoene mehr, s. Farbueberarbeitung
# 30.09.2026 (Orange kollidierte mit dem x220-Branding, Neongruen wirkte
# grell). Bewusst KEIN zusaetzliches
# Zeichen -- die Box-Breiten oben (_tab_w/_name_trunc) sind schon knapp
# bemessen (s. Fund 19.08./12.09.2026), ein Zeichen mehr wuerde sie wieder
# aufreissen.
_claude_prefix="#({{ .chezmoi.homeDir }}/.config/tmux/claude-pane-status-color.sh #{window_id})"

tmux set -g window-status-format "${_pip_prefix}${_claude_prefix}┌ #{p${_marker_w}:${_pip_marker}${_zoom_marker}}#{p${_num_area_w}:#{p-${_num_center_m}:#{window_index}}${_shared_marker}}#{p-${_flags_w}:${_flags_marker}} ┐#[default]"
tmux set -g window-status-current-format "┌ #{p${_marker_w}:${_pip_marker}${_zoom_marker}}#{p${_num_area_w}:#{p-${_num_center_m}:#{window_index}}${_shared_marker}}#{p-${_flags_w}:${_flags_marker}} ┐"

# Name-Ausdruck in Einzelschritten statt einer verschachtelten Zeile, damit
# lesbar bleibt, was mit "claude-" passiert: Präfix weg -> auf _name_trunc
# kürzen (mit Ellipse).
#
# Kein Marker/Flag mehr am Namen -- PiP-"▶", Zoom-Lupe 🔍 und die Flags
# "*"/"-"/"M" sitzen seit 05.10.2026 komplett oben in Zeile 1 (s.
# _pip_marker/_zoom_marker/_flags_marker weiter oben), dadurch bleibt hier
# unten der volle Platz fuer den Namen selbst.
_name_no_prefix="#{s/^(claude-|PRE-)//:window_name}"
_name_short="#{=/${_name_trunc}/…:${_name_no_prefix}}"
tmux set -g @window-status-format-row2 "${_pip_prefix}${_claude_prefix}└#{p${_tab_w}:${_name_short}}┘#[default]"
tmux set -g @window-status-current-format-row2 "└#{p${_tab_w}:${_name_short}}┘"
unset _tab_w _name_trunc _marker_w _flags_w _num_area_w _num_center_m _name_no_prefix _name_short _pip_prefix _pip_marker _flags_marker _claude_prefix _zoom_marker _shared_marker

# Session-Name links (status-left) als Zweizeilen-Kasten: oben der Name,
# unten die Gesamtzahl ALLER tmux-Sessions auf dem Server (nicht die
# Fensteranzahl der aktuellen Session -- die sieht man eh direkt an den
# Fenster-Tabs, s. Fund 19.08.2026). Kein Format-Variable dafür vorhanden
# (#{session_windows} ist per-Session), deshalb per Bash gezählt und als
# literale Zahl eingesetzt -- aktualisiert sich wie die Box-Breite erst
# beim nächsten Attach/Session-Wechsel, nicht live bei jeder neuen Session.
_sess_name="$(tmux display-message -p '#{session_name}')"
_total_sessions="$(tmux list-sessions | wc -l)"
_box_w=${#_sess_name}
[ "${#_total_sessions}" -gt "$_box_w" ] && _box_w=${#_total_sessions}
# Zentrierung der Zahl komplett in Bash statt über #{pN:...}: dessen
# Inhalt muss ein bekannter Format-Variablenname oder ein verschachtelter
# #{...}-Ausdruck sein, ein reines Literal wie unsere gezählte Zahl wird
# sonst als nicht existierende Variable interpretiert und ergibt leer
# (getestet 19.08.2026: #{p6:5} und #{p6:hello} liefern beide nur
# Leerzeichen, #{p6:#{session_name}} funktioniert dagegen).
_count_leftpad=$(( (_box_w - ${#_total_sessions}) / 2 ))
_count_rightpad=$(( _box_w - ${#_total_sessions} - _count_leftpad ))
_count_centered="$(printf '%*s%s%*s' "$_count_leftpad" '' "$_total_sessions" "$_count_rightpad" '')"
# Klick/Tap auf den Kasten ruft per MouseDown1StatusLeft-Bindung
# choose-session auf (siehe tmux.conf).
tmux set -g status-left "#[fg=black,bg=colour179,bold]┌#{p${_box_w}:#{session_name}}┐#[default] "
tmux set -g @status-left-row2 "#[fg=black,bg=colour179,bold]└${_count_centered}┘#[default] "
unset _sess_name _total_sessions _box_w _count_leftpad _count_rightpad _count_centered

# Rechts (status-right): iPhone kriegt nur den W-Knopf (kein Platz für mehr,
# Klick/Tap ruft per MouseDown1StatusRight choose-window auf). Laptop hat
# genug Breite -> Pane-Titel/Uhrzeit/Datum bleiben zusätzlich zum W-Knopf.
if $_iphone; then
  tmux set -g status-right "#({{ .chezmoi.homeDir }}/.config/tmux/plugins/tmux-continuum/scripts/continuum_save.sh)#{?window_bigger,[#{window_offset_x}#,#{window_offset_y}] ,}#[fg=black,bg=colour179,bold]┌W┐#[default]"
  # Kein Text vor dem Knopf (window_bigger ist im Normalfall leer) -> Zeile 2
  # startet ebenfalls bei Spalte 0, keine Polsterung nötig.
  tmux set -g @status-right-row2 "#[fg=black,bg=colour179,bold]└▾┘#[default]"
else
  # Datum+Uhrzeit stehen in Zeile 2, Zeile 1 hat dadurch Platz für einen
  # längeren Pane-Titel.
  #
  # FRÜHER war der Titel hier unbeschnitten/ungepolstert, in der Annahme,
  # status-right werde von tmux ohnehin bündig gegen den rechten Rand
  # positioniert (align=right in status-format) und die Knöpfe landeten
  # deshalb in beiden Zeilen an derselben Spalte -- das stimmt fuer die
  # KNOEPFE, aber NICHT fuer den Fenster-Tab-Bereich davor: status-format[0]
  # (oben) und status-format[1]/unten werden von tmux als voellig
  # UNABHAENGIGE Zeilen layoutet, jede mit ihrem eigenen Rest-Budget fuer
  # die Fenster-Tab-Liste = Terminalbreite minus status-left minus
  # status-right DIESER Zeile. Solange alles hineinpasst (wenige Fenster),
  # macht das keinen Unterschied. Passen nicht mehr alle Fenster-Boxen
  # hinein (z.B. Session AGENTS mit vielen Fenstern), kuerzt/scrollt tmux
  # die Liste PRO ZEILE einzeln -- und weil #{pane_title} (oben) und
  # "%d-%b-%y %H:%M" (unten) unterschiedlich lang sind, bekommen beide
  # Zeilen ein unterschiedliches Budget und zeigen dadurch verschiedene
  # Fenster -- die Doppel-Box reisst optisch auseinander (Fund 12.09.2026).
  #
  # Fix: beide Seiten auf dieselbe LITERALE (tmux kann Breitenangaben in
  # #{pN:}/#{=N:} nicht dynamisch aus einer anderen Option lesen -- Test
  # 12.09.2026: #{p#{pane_width}:...} ist ungueltig) aber grosszuegig
  # gewaehlte Breite polstern: #{=/N/…:...} kuerzt (mit Ellipse) nur, wenn
  # der Titel die Grenze WIRKLICH ueberschreitet, #{pN:...} polstert
  # kuerzere Inhalte (Titel wie Datum) auf dieselbe Breite auf. Damit ist
  # status-right in beiden Zeilen IMMER exakt gleich lang, unabhaengig vom
  # tatsaechlichen Titelinhalt -- die Fenster-Tab-Liste bekommt in beiden
  # Zeilen dasselbe Budget und bleibt synchron. 40 ist grosszuegig (fast
  # doppelt so breit wie der frueher verworfene Wert 21, s. Kommentar in
  # tmux.conf.tmpl) -- im Alltag wird praktisch nie gekuerzt.
  #
  # NACHTRAG 12.09.2026 (zweiter Fund, noch am selben Tag): #{=/N/…:...}
  # liefert bei TATSAECHLICHEM Kuerzen N ZEICHEN INHALT PLUS die Ellipse
  # OBENDRAUF -- also N+1 Zeichen, nicht N (empirisch verifiziert mit
  # tmux display-message, tmux 3.7b, reproduzierbar auch ganz ohne
  # Sonderzeichen/Emoji im Inhalt -- keine Breiten-Mehrdeutigkeit, einfach
  # ein Off-by-one in der Modifier-Semantik). Bei kurzen Titeln (keine
  # echte Kuerzung) faellt das nicht auf; sobald ein Titel die Grenze
  # WIRKLICH ueberschreitet, wird status-right dieser Zeile 1 Zeichen
  # breiter als das p${_status_right_w} der anderen Zeile -- exakt der
  # Riss bei langen Claude-Code-Fenstertiteln (Symptom: die Fenster-Tab-
  # Liste einer Zeile frisst dadurch 1 Zeichen ihrer eigenen Randbox aus).
  # Fix: die Ellipsenlaenge beim Kuerz-Ziel abziehen, das Polster-Ziel
  # bleibt bei der vollen Breite.
  _status_right_w=40
  _status_right_trunc=$((_status_right_w - 1))
  tmux set -g status-right "#({{ .chezmoi.homeDir }}/.config/tmux/plugins/tmux-continuum/scripts/continuum_save.sh)#{?window_bigger,[#{window_offset_x}#,#{window_offset_y}] ,}#{p${_status_right_w}:#{=/${_status_right_trunc}/…:#{pane_title}}} #[fg=black,bg=colour179,bold]┌W┐#[default]"
  # Datum/Uhrzeit in Zeile 2 mittig im _status_right_w-Feld statt linksbuendig
  # (Fund 12.09.2026): "%d-%b-%y %H:%M" ist IMMER exakt 15 Zeichen lang (2+1+3+1+2
  # + 1+2+1+2) -- auch im deutschen Locale sind alle Monatskuerzel (Jan...Dez,
  # inkl. "Mär") genau 3 Zeichen. Deshalb hier ohne Kompromiss-M wie bei den
  # variabel langen Fenster-Tabs (s. _num_center_m oben) exakt zentrierbar:
  # #{p-M:...} polstert zuerst rechtsbuendig auf M, #{pN:...} danach
  # linksbuendig auf die Gesamtbreite N -- ergibt bei fester Inhaltslaenge L
  # echte Zentrierung (Rundungsrest landet rechts).
  _date_len=15
  _date_center_m=$(( (_status_right_w + _date_len) / 2 ))
  tmux set -g @status-right-row2 "#{p${_status_right_w}:#{p-${_date_center_m}:#{=/${_status_right_trunc}/…:#{l:%d-%b-%y %H:%M}}}} #[fg=black,bg=colour179,bold]└▾┘#[default]"
  unset _status_right_w _status_right_trunc _date_len _date_center_m
fi

unset _iphone

# Zweite Statuszeile: 1:1-Kopie von status-format[0] (dupliziert live statt
# die riesige Default-Formatzeichenkette hart zu hinterlegen -- bleibt so
# synchron, falls sich Zeile 0 mal ändert), aber die status-left-,
# status-right- und window-status-(current-)format-Verweise werden gegen die
# Zeile-2-Varianten ausgetauscht, damit oben/unten unterschiedlicher Text
# erscheint.
_fmt0="$(tmux show-options -gv status-format[0])"
_fmt1="${_fmt0/:status-left\}/:@status-left-row2\}}"
_fmt1="${_fmt1/:status-right\}/:@status-right-row2\}}"
_fmt1="${_fmt1/:window-status-current-format\}/:@window-status-current-format-row2\}}"
_fmt1="${_fmt1/:window-status-format\}/:@window-status-format-row2\}}"
tmux set -g status-format[1] "$_fmt1"
unset _fmt0 _fmt1
