# CLI-Werkzeuge, installiert per `brew bundle --file="$HOME/.Brewfile"`
# (siehe .chezmoiscripts/run_once_after_70-install-brew-bundle.sh.tmpl)

brew "starship"
brew "zoxide"
brew "asdf"

brew "btop"
brew "croc"
brew "fd"
brew "fzf"
brew "erdtree"
brew "lazygit"
brew "mosh"
brew "neovim"
brew "qrcp"
brew "ripgrep"
brew "syncthing"
brew "tealdeer"
brew "tmux"
brew "w3m"
brew "wireguard-go"
brew "wireguard-tools"
brew "gh"
brew "glow"
brew "gping"

# ══════════════════════════════════════════════════════════════════
# CASKS (Linux + macOS - Homebrew kennt Casks auch unter Linux;
# dort sind es AppImage/Binary-Varianten; gimp nicht auf ihht (Kiosk))
# ══════════════════════════════════════════════════════════════════

cask "kitty"
{{- if ne .chezmoi.hostname "ihht" }}
cask "gimp"
{{- end }}
{{ if eq .chezmoi.os "darwin" }}
# ══════════════════════════════════════════════════════════════════
# CASKS (nur macOS)
# ══════════════════════════════════════════════════════════════════

cask "nomachine"
cask "keepassxc"
cask "audacity"
cask "libreoffice"
cask "libreoffice-language-pack", args: { language: "de" }
{{ end -}}
