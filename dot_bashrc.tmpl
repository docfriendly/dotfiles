# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples

# If not running interactively, don't do anything
[ -z "$PS1" ] && return

# ══════════════════════════════════════════════════════════════════
# HISTORY
# ══════════════════════════════════════════════════════════════════

# don't put duplicate lines in the history. See bash(1) for more options
# don't overwrite GNU Midnight Commander's setting of `ignorespace'.
HISTCONTROL=$HISTCONTROL${HISTCONTROL+:}ignoredups
# ... or force ignoredups and ignorespace
HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
shopt -s histappend

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)

# ══════════════════════════════════════════════════════════════════
# SHELL-VERHALTEN
# ══════════════════════════════════════════════════════════════════

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# make less more friendly for non-text input files, see lesspipe(1)
#[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# ══════════════════════════════════════════════════════════════════
# PROMPT (PS1)
# ══════════════════════════════════════════════════════════════════

# set variable identifying the chroot you work in (used in the prompt below)
if [ -z "$debian_chroot" ] && [ -r /etc/debian_chroot ]; then
  debian_chroot=$(cat /etc/debian_chroot)
fi

# set a fancy prompt (non-color, unless we know we "want" color)
case "$TERM" in
xterm-color) color_prompt=yes ;;
esac

# uncomment for a colored prompt, if the terminal has the capability; turned
# off by default to not distract the user: the focus in a terminal window
# should be on the output of commands, not on the prompt
# force_color_prompt=yes

if [ -n "$force_color_prompt" ]; then
  if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
    # We have color support; assume it's compliant with Ecma-48
    # (ISO/IEC-6429). (Lack of such support is extremely rare, and such
    # a case would tend to support setf rather than setaf.)
    color_prompt=yes
  else
    color_prompt=
  fi
fi

if [ "$color_prompt" = yes ]; then
  PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
  PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

# eigener zweizeiliger Farb-Prompt (überschreibt das PS1 von oben)
red='\[\e[0;31m\]'
RED='\[\e[1;31m\]'
blue='\[\e[0;34m\]'
BLUE='\[\e[1;34m\]'
cyan='\[\e[0;36m\]'
CYAN='\[\e[1;36m\]'
green='\[\e[0;32m\]'
GREEN='\[\e[1;32m\]'
yellow='\[\e[0;33m\]'
YELLOW='\[\e[1;33m\]'
PURPLE='\[\e[1;35m\]'
purple='\[\e[0;35m\]'
nc='\[\e[0m\]'

if [ "$UID" = 0 ]; then
  PS1="$red\u$nc@$red\H$nc:$CYAN\w$nc\\n$red#$nc "
else
  PS1="$PURPLE\u$nc@$CYAN\H$nc:$GREEN\w$nc\\n$GREEN\$$nc "
fi

# ══════════════════════════════════════════════════════════════════
# ALIASE
# ══════════════════════════════════════════════════════════════════

# Alias definitions.
# You may want to put all your additions into a separate file like
# ~/.bash_aliases, instead of adding them here directly.
# See /usr/share/doc/bash-doc/examples in the bash-doc package.

if [ -f ~/.bash_aliases ]; then
  . ~/.bash_aliases
fi

# ══════════════════════════════════════════════════════════════════
# PAGER & COMPLETION
# ══════════════════════════════════════════════════════════════════

# Default parameter to send to the "less" command
# -R: show ANSI colors correctly; -i: case insensitive search
[ -z "$LESS" ] && export LESS="-R -i"

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if [ -f /etc/bash_completion ] && ! shopt -oq posix; then
  . /etc/bash_completion
fi

# ══════════════════════════════════════════════════════════════════
# PATH & TERMINAL
# ══════════════════════════════════════════════════════════════════

# Add sbin directories to PATH.  This is useful on systems that have sudo
echo $PATH | grep -Eq "(^|:)/sbin(:|)" || PATH=$PATH:/sbin
echo $PATH | grep -Eq "(^|:)/usr/sbin(:|)" || PATH=$PATH:/usr/sbin

# If this is an xterm set the title to user@host:dir
case "$TERM" in
xterm* | rxvt*)
  PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
  ;;
*) ;;
esac

# ══════════════════════════════════════════════════════════════════
# Nutzer-Anpassungen
# (eigene Ergänzungen zum Debian-Standard-.bashrc; muss vor dem
#  Tool-Init-Block unten stehen, da starship/zoxide PROMPT_COMMAND
#  beim Initialisieren mit übernehmen. chezmoi()/tealdeer() liegen in
#  ~/.bash_aliases, das oben in ALIASE bereits vor diesem Block
#  geladen wird.)
# ══════════════════════════════════════════════════════════════════

# Nach jedem Kommando: History sichern und neu einlesen
export PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND$'\n'}history -a; history -c; history -r"

# sudo cached standardmäßig PRO TTY (tty_tickets), nicht global pro User -
# jede neue Session hat also eigentlich ihr eigenes, zunächst kaltes Cache,
# selbst wenn woanders gerade eine warme Session offen ist. Der Marker muss
# das nachbilden, sonst zeigt eine frisch eingeloggte Session fälschlich
# warm, nur weil irgendeine andere Session kürzlich sudo benutzt hat. Export,
# damit starships Custom-Modul-Subshell (eigener stdin/stdout, `tty` dort
# ggf. nicht verlässlich) denselben Wert sieht.
export _SUDO_CACHE_TTY="$(tty 2>/dev/null | tr -c 'A-Za-z0-9' '_')"
export _SUDO_CACHE_FILE="$HOME/.cache/sudo-last-used${_SUDO_CACHE_TTY:+.$_SUDO_CACHE_TTY}"

# Merkt sich (rein lesend aus der History, ruft sudo selbst NIE auf) wann
# zuletzt "sudo ..." getippt wurde. Basis für die starship-Anzeige, ob das
# sudo-Timestamp-Cache noch warm ist, ohne das Fenster durch den Check selbst
# zu verlängern (siehe [custom.sudo_cache] in starship.toml).
_track_sudo_use() {
  local last
  read -r last _ <<<"$(fc -ln -1 2>/dev/null)"
  if [ "$last" = "sudo" ]; then
    mkdir -p "$HOME/.cache" 2>/dev/null
    touch "$_SUDO_CACHE_FILE" 2>/dev/null
  fi
}
# Registrierung bewusst NICHT hier (siehe unten, nach dem Tool-Init-Block):
# starship hängt sich bei "starship init bash" vorne an PROMPT_COMMAND -
# eine Registrierung hier würde also NACH starship_precmd laufen, also erst
# einen Prompt zu spät.

# ══════════════════════════════════════════════════════════════════
# TOOL-INIT / UMGEBUNG
# WICHTIG: starship/zoxide müssen ganz am Ende der Datei initialisiert
# werden, damit sie PROMPT_COMMAND vollständig übernehmen können.
# ══════════════════════════════════════════════════════════════════

# Rust-env dynamisch anhand ~/.tool-versions laden, statt eine feste
# Version hart zu kodieren (die sich bei asdf-Updates sonst leise von
# der tatsächlich installierten Version entkoppelt)
if [ -f "$HOME/.tool-versions" ]; then
  rust_version=$(awk '/^rust /{print $2}' "$HOME/.tool-versions")
  if [ -n "$rust_version" ] && [ -f "$HOME/.asdf/installs/rust/$rust_version/env" ]; then
    . "$HOME/.asdf/installs/rust/$rust_version/env"
  fi
  unset rust_version
fi

{{ if eq .chezmoi.os "darwin" -}}
eval "$(/opt/homebrew/bin/brew shellenv bash)"
{{- else -}}
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv bash)"
{{- end }}
export PATH="$HOME/.asdf/shims:$PATH"
eval "$(starship init bash)"
eval "$(zoxide init bash)"
export PATH="$HOME/.local/bin:$PATH"

# _track_sudo_use muss VOR starship_precmd laufen, damit die Marker-Datei
# schon aktuell ist, wenn starship [custom.sudo_cache] rendert. Deshalb hier
# vorne einreihen statt (wie sonst überall) hinten anhängen.
PROMPT_COMMAND="_track_sudo_use${PROMPT_COMMAND:+$'\n'$PROMPT_COMMAND}"
