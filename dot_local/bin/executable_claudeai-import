#!/usr/bin/env python3
"""claudeai-import <conversations-000.zip | conversations.json | Ordner> [Zielordner]

Wandelt den claude.ai-Datenexport (Einstellungen -> Datenschutz -> Export data,
nur im Browser/Desktop, nicht in der iOS-App) in das JSONL-Format um, das
`claudegrep` von Claude-Code-Sessions kennt. Pro Chat eine Datei
<Zielordner>/<chat-uuid>.jsonl; ein erneuter Import überschreibt sie (idempotent).

Zielordner-Default: ~/.claude/claude-ai-export -- bewusst NICHT unter
~/.claude/projects, sonst hielte Claude Code die Dateien für eigene Sessions.

Übernommen wird nur Text (Blocktyp "text") plus extrahierter Anhangtext;
thinking/tool_use/tool_result fallen weg, das ignoriert claudegrep ohnehin.
Verzweigte Chats (regenerierte/bearbeitete Nachrichten): alle Varianten bleiben,
sortiert nach Zeitstempel.
"""
import json
import sys
import zipfile
from pathlib import Path


def load(src: Path):
    if src.is_dir():
        src = next(src.rglob("conversations.json"))
    if src.suffix == ".zip":
        with zipfile.ZipFile(src) as z:
            name = next(n for n in z.namelist() if n.endswith("conversations.json"))
            return json.loads(z.read(name))
    return json.loads(src.read_text(encoding="utf-8"))


def message_text(msg: dict) -> str:
    blocks = msg.get("content") or []
    parts = [b.get("text", "") for b in blocks if b.get("type") == "text"]
    if not parts and msg.get("text"):  # Fallback: Top-Level-Feld
        parts = [msg["text"]]
    for att in msg.get("attachments") or []:
        body = att.get("extracted_content")
        if body:
            parts.append(f"[Anhang: {att.get('file_name', '?')}]\n{body}")
    return "\n\n".join(p for p in parts if p).strip()


def title_of(chat: dict, msgs: list) -> str:
    if chat.get("name"):
        return chat["name"]
    for m in msgs:
        if m["role"] == "user":
            first = " ".join(m["text"].split())[:60]
            return f"(ohne Titel) {first}"
    return "(ohne Titel)"


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    dest = Path(sys.argv[2] if len(sys.argv) > 2 else "~/.claude/claude-ai-export").expanduser()
    dest.mkdir(parents=True, exist_ok=True)
    chats = load(Path(sys.argv[1]).expanduser())

    n_chats = n_msgs = 0
    for chat in chats:
        rows = []
        for m in sorted(chat.get("chat_messages", []), key=lambda m: m["created_at"]):
            text = message_text(m)
            if not text:
                continue
            role = "user" if m["sender"] == "human" else "assistant"
            rows.append({"role": role, "text": text, "ts": m["created_at"]})
        if not rows:
            continue
        sid = chat["uuid"]
        lines = [{"type": "ai-title", "aiTitle": title_of(chat, rows), "sessionId": sid}]
        for r in rows:
            lines.append({
                "type": r["role"],
                "message": {"role": r["role"], "content": [{"type": "text", "text": r["text"]}]},
                "sessionId": sid,
                "timestamp": r["ts"],
                "cwd": "claude.ai",
            })
        with open(dest / f"{sid}.jsonl", "w", encoding="utf-8") as f:
            for line in lines:
                f.write(json.dumps(line, ensure_ascii=False) + "\n")
        n_chats += 1
        n_msgs += len(rows)
    print(f"{n_chats} Chats / {n_msgs} Nachrichten -> {dest}")


if __name__ == "__main__":
    main()
