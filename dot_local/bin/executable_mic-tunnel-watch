#!/bin/bash
# mic-tunnel-watch -- nur x230 (per .chezmoiignore).
#
# Koppelt einen SSH-Reverse-Tunnel zum x220 an den Stumm-Status des
# Standard-Mikrofons: Mikro entmutet (XF86AudioMicMute, Panel-Plugin,
# pavucontrol -- egal wie) -> Tunnel auf, Mikro stumm -> Tunnel zu.
# Zweck: Claude-Code-Diktat (/voice) auf dem x220 nimmt so das x230-Mikro.
# Der x220-Wrapper claude() (dot_bash_aliases) setzt PULSE_SERVER auf den
# Socket, sobald er lebt.
#
# Aufbau: Unix-Socket -> Unix-Socket, kein TCP-Listener. Auf dem x220 gehoert
# der Socket harry, andere Benutzer kommen nicht heran. Mikro-Zugriff besteht
# nur, solange das Mikro entmutet ist.
# Autostart: ~/.config/autostart/mic-tunnel-watch.desktop.
# Beim Start wird das Mikro einmal stummgeschaltet (sicherer Grundzustand).

REMOTE=x220
RSOCK=/run/user/1000/x230-pulse          # Pfad auf dem x220
LSOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pulse/native"
PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/mic-tunnel.pid"
LOCK="${XDG_RUNTIME_DIR:-/tmp}/mic-tunnel-watch.lock"
LAST=""                                  # letzter gemeldeter Zustand

exec 9>"$LOCK"
flock -n 9 || exit 0                     # nur eine Instanz

meldung() {                              # meldung <icon> <titel> <text>
    notify-send -t 2500 -i "$1" \
        -h string:x-canonical-private-synchronous:mic-tunnel "$2" "$3" 2>/dev/null
}

tunnel_lebt() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

tunnel_auf() {
    # Alter Socket vom x220 wegraeumen (nach Abbruch bleibt er stehen).
    ssh -o BatchMode=yes -o ConnectTimeout=5 -o ControlPath=none "$REMOTE" \
        "rm -f $RSOCK" 2>/dev/null || return 1
    ssh -N -o BatchMode=yes -o ConnectTimeout=5 -o ExitOnForwardFailure=yes \
        -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
        -o ControlMaster=no -o ControlPath=none \
        -R "$RSOCK:$LSOCK" "$REMOTE" &
    local pid=$!
    sleep 1.5
    if kill -0 "$pid" 2>/dev/null; then
        echo "$pid" > "$PIDFILE"
        return 0
    fi
    return 1
}

tunnel_zu() {
    if tunnel_lebt; then
        kill "$(cat "$PIDFILE")" 2>/dev/null
    fi
    rm -f "$PIDFILE"
}

abgleich() {
    local stumm
    stumm=$(pactl get-source-mute @DEFAULT_SOURCE@ 2>/dev/null | awk '{print $2}')
    [ -n "$stumm" ] || return
    if [ "$stumm" = no ]; then
        if ! tunnel_lebt; then
            if tunnel_auf; then
                [ "$LAST" = auf ] || meldung microphone-sensitivity-high \
                    "Mikro-Tunnel offen" "x230-Mikro steht auf dem x220 bereit"
                LAST=auf
            else
                [ "$LAST" = fehler ] || meldung dialog-warning \
                    "Mikro-Tunnel fehlgeschlagen" "x220 nicht erreichbar, neuer Versuch folgt"
                LAST=fehler
            fi
        fi
    else
        if tunnel_lebt; then
            tunnel_zu
            meldung microphone-sensitivity-muted "Mikro-Tunnel zu" "x230-Mikro ist stumm"
        fi
        LAST=zu
    fi
}

trap 'tunnel_zu; [ -n "$PS_PID" ] && kill "$PS_PID" 2>/dev/null; exit 0' INT TERM EXIT

pactl set-source-mute @DEFAULT_SOURCE@ 1 2>/dev/null

while true; do
    # 9>&- : coproc darf den Lock-FD nicht erben, sonst haelt ein verwaister
    # pactl den Lock und blockiert einen Neustart des Skripts.
    coproc PS { exec pactl subscribe 2>/dev/null 9>&-; }
    abgleich
    while true; do
        if read -r -t 10 -u "${PS[0]}" zeile; then
            case "$zeile" in
                *" on source "*|*" on server "*) abgleich ;;
            esac
        else
            [ $? -gt 128 ] || break      # Timeout: Wiederverbinden pruefen
            abgleich
        fi
    done
    kill "$PS_PID" 2>/dev/null
    sleep 5                              # pactl subscribe weg (PipeWire neu gestartet)
done
