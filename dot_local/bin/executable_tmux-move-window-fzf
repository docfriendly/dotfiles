#!/usr/bin/env bash
# Aktuelles tmux-Fenster per fzf in eine andere Session verschieben.
# Ersatz fuer das Standard-Prefix+. (move-window, tippt den Zielnamen von Hand).
#
# Eingebunden via (tmux.conf.tmpl, run-shell expandiert die Formate):
#   bind . run-shell -b "tmux display-popup -c '#{client_name}' -E -w 40% -h 12 -y 12 \
#     -T 'Fenster verschieben' \"$HOME/.local/bin/tmux-move-window-fzf '#{window_id}' '#{client_name}'\""
#
# $1 ist die window_id (@N), $2 der Client-Name (/dev/pts/N). display-popup
# selbst expandiert Formate nur im Titel, daher der Umweg ueber run-shell. Der
# Client wird gebraucht, weil switch-client im Popup sonst irgendeinen "letzten"
# Client trifft (mehrere Clients moeglich).
#
# fzf listet die vorhandenen Sessions (ohne die des Fensters selbst). Wird ein
# Name getippt, der es nicht gibt, legt das Script die Session neu an. Das
# Fenster haengt am naechsten freien Index; Esc/leere Eingabe bricht ab.
# Neu angelegte Sessions bringen ein leeres Start-Fenster mit; das wird nach
# dem Verschieben entfernt und die Indizes neu durchnummeriert.
# Danach springt der Client in die Zielsession auf das verschobene Fenster.

set -euo pipefail

src=${1:?window_id fehlt}
client=${2:-}
cur=$(tmux display -p -t "$src" '#{session_name}')

out=$(tmux list-sessions -F '#{session_name}' \
  | grep -vxF -- "$cur" \
  | fzf --prompt='Fenster nach > ' --reverse --print-query --height=100% \
  ) || rc=$?

# --print-query: erste Zeile = getippter Text, zweite = gewaehlter Treffer.
# Exit 1 = kein Treffer (getippter Name wird dann als neue Session genutzt),
# Exit 130 = Esc.
[ "${rc:-0}" -eq 130 ] && exit 0
sel=$(printf '%s\n' "$out" | sed -n '2p')
[ -n "$sel" ] || sel=$(printf '%s\n' "$out" | sed -n '1p')
[ -n "$sel" ] || exit 0

placeholder=
if ! tmux has-session -t "=$sel" 2>/dev/null; then
  placeholder=$(tmux new-session -d -s "$sel" -P -F '#{window_id}')
fi
tmux move-window -s "$src" -t "$sel:"
if [ -n "$placeholder" ]; then
  tmux kill-window -t "$placeholder"
  tmux move-window -r -t "=$sel:"
fi
tmux select-window -t "$src"
tmux switch-client ${client:+-c "$client"} -t "=$sel"
