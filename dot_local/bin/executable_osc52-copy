#!/usr/bin/env bash
# stdin -> rohe OSC-52-Sequenz auf das TTY JEDES angehaengten tmux-Clients.
#
# Eingebunden via:  set -g @fingers-main-action '/home/harry/.local/bin/osc52-copy'
#
# Hintergrund (clipdiag-Differentialtest, 01.09.2026): tmux' eigenes
# `tmux load-buffer -w` (server-originiertes OSC 52) kommt ueber SSH NICHT beim
# Kitty-Client am x230 an, obwohl set-clipboard=on. Eine *rohe* OSC-52-Sequenz,
# direkt aufs Client-TTY geschrieben, geht dagegen via sshd sauber ans Terminal.
# tmux-fingers setzt den tmux-Buffer selbst weiter (action_runner ruft immer
# set_buffer auf) -> Mittelklick INNERHALB tmux bleibt erhalten.
#
# Schleife ueber alle Clients: sind Kitty (x230) und Termius (iPhone) zugleich
# angehaengt, bekommen beide den Treffer.
#
# ;c; = CLIPBOARD  -> am x230 mit Strg+V (Browser) / Strg+Shift+V (Terminal)
# ;p; = PRIMARY    -> Mittelklick; kommt bei Kitty/x230 derzeit nicht an,
#                     schadet aber nicht und koennte bei Termius/spaeter greifen.

b64=$(base64 | tr -d '\n')

ttys=$(tmux list-clients -F '#{client_tty}' 2>/dev/null)
[ -n "$ttys" ] || ttys=/dev/tty

while IFS= read -r tty; do
  [ -w "$tty" ] || continue
  printf '\033]52;c;%s\a' "$b64" > "$tty"
  printf '\033]52;p;%s\a' "$b64" > "$tty"
done <<< "$ttys"
