#!/bin/bash
set -eufo pipefail

# ══════════════════════════════════════════════════════════════════
# ABSCHLUSS: WARNUNGEN UND HINWEISE DIESES APPLY ANZEIGEN
# Sammelt, was die weichen Schritte (.chezmoitemplates/softstep.sh) mit warn
# und note notiert haben, und zeigt es als ein Block am Ende. Danach werden
# die Logs geleert (die Zeilen wandern nach ~/.cache/chezmoi-warnungen.history);
# ein fehlgeschlagener Schritt meldet sich beim naechsten Apply von selbst
# wieder, weil sein Stempel fehlt.
# ══════════════════════════════════════════════════════════════════

CACHE="$HOME/.cache"
WARN="$CACHE/chezmoi-warnungen.log"
NOTE="$CACHE/chezmoi-hinweise.log"

show() { # show <Datei> <Titel>
  [ -s "$1" ] || return 0
  printf '\n######## %s ########\n' "$2"
  cat "$1"
}

if [ -s "$WARN" ] || [ -s "$NOTE" ]; then
  show "$NOTE" "HINWEISE"
  show "$WARN" "WARNUNGEN (Schritte wiederholen sich beim naechsten Apply)"
  printf '\n########################################\n'
  [ -s "$WARN" ] && cat "$WARN" >> "$CACHE/chezmoi-warnungen.history"
  : > "$WARN"
  : > "$NOTE"
else
  echo "==> Apply ohne Warnungen und Hinweise."
fi
