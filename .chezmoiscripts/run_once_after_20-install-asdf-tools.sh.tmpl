#!/bin/bash
set -eufo pipefail

# ══════════════════════════════════════════════════════════════════
# BREW-PFAD ERMITTELN
# (macOS: /opt/homebrew, Linux: /home/linuxbrew/.linuxbrew)
# ══════════════════════════════════════════════════════════════════

{{ if eq .chezmoi.os "darwin" -}}
BREW_PREFIX="/opt/homebrew"
{{- else -}}
BREW_PREFIX="/home/linuxbrew/.linuxbrew"
{{- end }}

eval "$("$BREW_PREFIX/bin/brew" shellenv bash)"

# ══════════════════════════════════════════════════════════════════
# PLUGINS REGISTRIEREN
# (asdf selbst kommt aus dem Brewfile-Bundle, run_once_after_10)
# ══════════════════════════════════════════════════════════════════

for plugin in nodejs python ruby rust; do
  asdf plugin add "$plugin" 2>/dev/null || true
done

# ══════════════════════════════════════════════════════════════════
# TOOL-VERSIONEN INSTALLIEREN
# (liest ~/.tool-versions, das per chezmoi verwaltet wird)
# ══════════════════════════════════════════════════════════════════

if [ -f "$HOME/.tool-versions" ]; then
  echo "==> Installiere Tool-Versionen aus ~/.tool-versions..."
  asdf install
else
  echo "WARNUNG: ~/.tool-versions nicht gefunden - bitte per 'chezmoi add ~/.tool-versions' verwalten lassen." >&2
fi
