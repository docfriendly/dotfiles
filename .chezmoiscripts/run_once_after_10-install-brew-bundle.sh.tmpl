#!/bin/bash
set -eufo pipefail

# ══════════════════════════════════════════════════════════════════
# BREW-PFAD ERMITTELN
# (macOS: /opt/homebrew, Linux: /home/linuxbrew/.linuxbrew)
# ══════════════════════════════════════════════════════════════════

{{ if eq .chezmoi.os "darwin" -}}
BREW_PREFIX="/opt/homebrew"
{{- else -}}
BREW_PREFIX="/home/linuxbrew/.linuxbrew"
{{- end }}

eval "$("$BREW_PREFIX/bin/brew" shellenv bash)"

# ══════════════════════════════════════════════════════════════════
# PAKETE AUS ~/.Brewfile INSTALLIEREN
# (läuft als run_once_after, da ~/.Brewfile erst beim Dotfile-Apply
#  geschrieben wird)
# ══════════════════════════════════════════════════════════════════

brew bundle --file="$HOME/.Brewfile"

# ══════════════════════════════════════════════════════════════════
# FZF SHELL-INTEGRATION
# (--all beantwortet die sonst interaktiven Ja/Nein-Abfragen automatisch,
#  --no-update-rc verhindert Änderungen an .bashrc durch das fzf-Skript)
# ══════════════════════════════════════════════════════════════════

if [ -x "$BREW_PREFIX/opt/fzf/install" ]; then
  "$BREW_PREFIX/opt/fzf/install" --all --no-update-rc
fi
