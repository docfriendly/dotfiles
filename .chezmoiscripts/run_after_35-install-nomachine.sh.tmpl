#!/bin/bash
set -eufo pipefail

{{ if ne .chezmoi.os "darwin" -}}
# ══════════════════════════════════════════════════════════════════
# NOMACHINE 9 (nur Linux - macOS läuft über den Cask im Brewfile)
# NoMachine 10 (seit 30.07.2026) hat den kostenlosen Server abgeschafft:
# Die Personal Edition braucht ein Abo (ca. 24,50 USD/Jahr) oder eine
# 14-Tage-Evaluierungslizenz mit Online-Validierung. Die 9.x-Reihe ist
# weiter kostenlos und wird gepflegt (9.10.x), die 9.x-.deb-Pakete werden
# auf download.nomachine.com aber nicht mehr angeboten (alle geratenen
# Pfade antworten 302 -> Startseite, geprüft 12.10.2026).
#
# Deshalb: kein Download, sondern ein .deb aus dem Vault
#   ~/Sync/vault/script/common/vendor/nomachine_9.*_amd64.deb
# (dort liegen auch Deskflow-.deb und libdvdcss-Tarball; daneben
# <datei>.sha256 wie bei Deskflow). `dpkg-repack` taugt NICHT als Quelle (nur ein
# 29-KB-Stub, siehe unten); der NoMachine-Updater liefert kein .deb, sondern
# ersetzt Dateien in /usr/NX direkt.
# Herkunft des abgelegten Pakets (16.10.2026): nomachine_9.8.2_1_amd64.deb aus
# github.com/mikorist/nomachine-free-9 (Drittanbieter-Mirror, nicht von
# NoMachine; SHA256 6c26d79c…b83b64 = Angabe der Release-Seite). Gegengeprüft:
# Skripte (prerm) bis auf Versionszeile identisch zum offiziellen 9.10.3,
# 3616 von 3685 Nutzlast-Dateien byte-gleich zum offiziell installierten
# 9.10.3 (x220), keine Netzwerkaufrufe im postinst. Die 69 abweichenden
# Dateien (nx*.bin, Bibliotheken) sind nicht verifizierbar - deshalb ruft das
# Skript nach der Installation `nxupdatecli --upgrade` auf: der ersetzt sie
# durch die offiziellen Dateien des aktuellen 9.x (ihht 17.10.2026: 9.8.2 ->
# 9.10.3, "68 files updated", ~3 min, Internet zu NoMachine noetig; bleibt in
# der 9er-Reihe, auch nach Erscheinen von 10).
# run_after statt run_once: Das .deb darf nach dem ersten Apply nachgereicht
# werden (Syncthing); das Skript ist idempotent und fragt sudo nur, wenn
# wirklich installiert wird.
# Es wird nur installiert, wenn die Paketversion mit 9. beginnt - ein
# versehentlich abgelegtes 10er-Paket wird abgelehnt. Fehlt das .deb,
# endet das Skript mit Hinweis und Exit 0 (NoMachine ist optional).
# ══════════════════════════════════════════════════════════════════

# Mischzustand erkennen (ihht, 17.10.2026): dpkg kennt /usr/NX nicht, ein
# `dpkg --purge` laesst die Nutzlast liegen, und der postinst eines 9.x-Pakets
# behaelt eine vorhandene 10.x-Installation ("Updating nxserver version:
# 10.2.3") - dpkg meldet dann 9.8.2, laufen tut 10 und verlangt eine Lizenz.
# Saubere Neuinstallation: sudo dpkg --purge nomachine && sudo rm -rf /usr/NX /etc/NX /var/NX
NX_VERSION="$(cat /usr/NX/etc/version 2>/dev/null || true)"

# Das 10er-Paket heisst nomachine-personal-edition (nicht nomachine): ein
# `dpkg --purge nomachine` trifft es nicht, und `Replaces` laesst dpkg die
# 9.x-Dateien nicht entpacken (postinst: Exit 127). Rettung auf ihht:
#   sudo rm -f /var/lib/dpkg/info/nomachine{,-personal-edition}.prerm
#   sudo dpkg --purge nomachine nomachine-personal-edition
if dpkg -s nomachine-personal-edition >/dev/null 2>&1; then
  echo "FEHLER: Paket nomachine-personal-edition ($(dpkg-query -W -f='${Version}' nomachine-personal-edition)) ist installiert (10.x braucht Lizenz)." >&2
  echo "        Entfernen: sudo dpkg --purge nomachine-personal-edition && sudo rm -rf /usr/NX /etc/NX /var/NX, dann erneut anwenden." >&2
  exit 1
fi

if dpkg -s nomachine >/dev/null 2>&1; then
  DPKG_VERSION="$(dpkg-query -W -f='${Version}' nomachine)"
  if [ -n "$NX_VERSION" ] && [ "${NX_VERSION%%.*}" != "${DPKG_VERSION%%.*}" ]; then
    echo "FEHLER: dpkg meldet NoMachine $DPKG_VERSION, /usr/NX/etc/version aber $NX_VERSION (Mischzustand)." >&2
    echo "        Bereinigen: sudo dpkg --purge nomachine && sudo rm -rf /usr/NX /etc/NX /var/NX, dann erneut anwenden." >&2
    exit 1
  fi
  echo "==> NoMachine bereits installiert ($DPKG_VERSION), überspringe."
  exit 0
fi

if [ -n "$NX_VERSION" ]; then
  echo "FEHLER: NoMachine $NX_VERSION liegt noch in /usr/NX, ist aber nicht als Paket installiert (Rest eines purge)." >&2
  echo "        Bereinigen: sudo rm -rf /usr/NX /etc/NX /var/NX, dann erneut anwenden." >&2
  exit 1
fi

VAULT_DIR="$HOME/Sync/vault/script/common/vendor"
DEB_PATH=""
if [ -d "$VAULT_DIR" ]; then
  # neuestes 9.x-Paket (Versionssortierung)
  DEB_PATH="$(find "$VAULT_DIR" -maxdepth 1 -name 'nomachine_9.*_amd64.deb' | sort -V | tail -n 1)"
fi

if [ -z "$DEB_PATH" ]; then
  echo "==> NoMachine übersprungen: kein nomachine_9.*_amd64.deb in $VAULT_DIR." >&2
  echo "    Siehe Kommentar in $0 (NoMachine 10 braucht Lizenz)." >&2
  exit 0
fi

if [ -f "$DEB_PATH.sha256" ]; then
  # Syncthing kann halb übertragene Dateien liegen lassen; Prüfsumme fängt das ab.
  (cd "$(dirname "$DEB_PATH")" && sha256sum -c --quiet "$(basename "$DEB_PATH").sha256")
fi

# Das echte Paket ist ~50 MB. Ein `dpkg-repack` des installierten Pakets ist
# nur ein ~29-KB-Stub (die Nutzlast entpackt das Paketskript nach /usr/NX, dpkg
# kennt sie nicht; die tar.gz unter /usr/share/NX/packages sind leer) und
# installiert nichts Brauchbares (geprüft 16.10.2026).
if [ "$(stat -c %s "$DEB_PATH")" -lt 10000000 ]; then
  echo "FEHLER: $DEB_PATH ist zu klein für ein NoMachine-Paket (Repack-Stub?)." >&2
  exit 1
fi

DEB_VERSION="$(dpkg-deb --field "$DEB_PATH" Version)"
case "$DEB_VERSION" in
  9.*) ;;
  *) echo "FEHLER: $DEB_PATH hat Version $DEB_VERSION, erwartet 9.x (10 braucht Lizenz)." >&2; exit 1 ;;
esac

echo "==> Installiere NoMachine $DEB_VERSION aus dem Vault..."
sudo apt-get install -y "$DEB_PATH"

# Binaries des Drittanbieter-Pakets durch die offiziellen ersetzen (siehe oben).
echo "==> NoMachine-Updater: ersetze Dateien durch das offizielle 9.x (dauert einige Minuten)..."
if sudo /usr/NX/bin/nxupdatecli --upgrade; then
  NX_AFTER="$(cat /usr/NX/etc/version 2>/dev/null || true)"
  echo "==> NoMachine jetzt auf $NX_AFTER."
  case "$NX_AFTER" in
    9.*) ;;
    *) echo "FEHLER: Updater hat auf $NX_AFTER gewechselt (erwartet 9.x) - Bereinigung siehe Kommentar oben." >&2; exit 1 ;;
  esac
else
  echo "WARNUNG: NoMachine-Updater fehlgeschlagen - die Mirror-Binaries (Version $DEB_VERSION) bleiben. Spaeter von Hand: sudo /usr/NX/bin/nxupdatecli --upgrade" >&2
fi
{{ end -}}
