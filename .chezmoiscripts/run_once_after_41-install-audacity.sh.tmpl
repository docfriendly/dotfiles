#!/bin/bash
set -eufo pipefail

{{ if ne .chezmoi.os "darwin" -}}
# ══════════════════════════════════════════════════════════════════
# AUDACITY (nur Linux - macOS läuft über den Cask im Brewfile)
# Homebrew hat für Audacity nur einen macOS-Cask, kein
# Linuxbrew-Formula - daher hier über apt.
# ══════════════════════════════════════════════════════════════════

if dpkg -s audacity >/dev/null 2>&1; then
  echo "==> Audacity bereits installiert, überspringe."
else
  echo "==> Installiere Audacity..."
  sudo apt-get install -y audacity
fi
{{ end -}}
